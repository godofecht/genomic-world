# One frame of the life world: the scene, tracers, organisms and effects
# in the 2D view or the 3D view, and the overlay in a transparent frame of
# its own. Frames are double-buffered (the other may still be on screen).
#
# On a large panel the world can be drawn at half size (organisms) and a
# quarter (water), and scaled up by the GPU on screen, while the overlay's
# text is drawn at full size. The overlay is redrawn every few frames.

import "stdlib/memory.flow"
import gsim.config
import glife.lconfig
import glife.lworld
import glife.census
import .fb
import .camera
import .scene
import .bodies
import .tracers
import .hud
import .view3d

@cEmbed("#include <time.h>
static double view_ms_c(void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1000000.0;
}")

extern {
    function view_ms_c() -> f64
}

struct Shown {
    world: Frame,
    hud: Frame,
    hud_fresh: bool
}

struct View {
    a: Frame,
    b: Frame,
    # the world at half size when half is set, and the water at a quarter
    la: Frame,
    lb: Frame,
    q: Frame,
    # the overlay, transparent
    ha: Frame,
    hb: Frame,
    hud_flip: bool,
    hud_every: i32,
    frame_no: i32,
    dl_lo: DrawList,
    half: bool,
    # with half: the scene (water, relief) at a quarter, scaled up twice
    quarter: bool,
    flip: bool,
    w: i32,
    h: i32,
    cam: Camera,
    cam3: Cam3,
    scene: Scene,
    dl: DrawList,
    tr: Tracers,
    v3: View3,
    hud: Hud,
    style: i32,
    flow_view: bool,
    view3d: bool,
    clock: f32,
    # milliseconds in each part of the last frame, when profiling:
    # 0 fields, 1 scene, 2 tracers, 3 organisms, 4 effects, 5 scale-up,
    # 6 overlay
    profile: bool,
    prof: ptr<f64>
}

export function view_new(w: i32, h: i32) -> View {
    let mut u: f32 = (h as f32) / 982.0
    if u < 1.0 { u = 1.0 }
    return View {
        a: fb_new(w, h), b: fb_new(w, h), la: fb_new(w / 2, h / 2), lb: fb_new(w / 2, h / 2),
        q: fb_new(w / 4, h / 4), ha: fb_new_alpha(w, h), hb: fb_new_alpha(w, h), hud_flip: false,
        hud_every: 3, frame_no: 0,
        dl_lo: drawlist_new(h / 2), half: false, quarter: false, flip: false, w: w, h: h,
        cam: cam_new(w, h), cam3: cam3_new(w, h), scene: scene_new(), dl: drawlist_new(h),
        tr: tracers_new(), v3: view3_new(w, h), hud: hud_new(u, h),
        style: STYLE_NATURAL, flow_view: false, view3d: false, clock: 0.0,
        profile: false, prof: alloc_zeroed(8 * 8) as ptr<f64>
    }
}

# Fresh cameras and the habitat's usual style, for a new world.
export function view_reset(v: ptr<View>, l: ptr<Life>) -> void {
    v.cam = cam_new(v.w, v.h)
    v.cam.wrap = l.cfg.habitat == HAB_OCEAN
    v.cam3 = cam3_new(v.w, v.h)
    v.cam3.wrap = v.cam.wrap
    if l.cfg.habitat == HAB_SLIDE {
        # A slide is long: fit its width.
        v.cam.scale = (v.w as f32) * 0.78 / 250.0
        v.style = STYLE_BRIGHT
        v.cam3.dist = 170.0
    } else {
        v.style = STYLE_NATURAL
    }
    v.tr = tracers_new()
    v.tr.ev_seen = l.ev_total
    v.scene.built_open = -1
}

# Advance what moves on screen but is not the simulation.
export function view_tick(v: ptr<View>, l: ptr<Life>, ticks: i32) -> void {
    v.clock = v.clock + (ticks as f32)
    if l.cfg.flow > 0.0 {
        tracers_step(&v.tr, l, ticks as f32)
    } else {
        tracers_step(&v.tr, l, 0.0)
    }
}

# Render a frame: the world, and the overlay when it is due (or forced).
export function view_render(v: ptr<View>, l: ptr<Life>, cs: ptr<Census>, preset: i32, steps: i32,
                            paused: bool, selected: i32, fps: f32, force_hud: bool) -> Shown {
    let mut t: f64 = view_ms_c()
    scene_terrain(&v.scene, &l.env)
    scene_vorticity(&v.scene, &l.fluid)
    t = vlap(v, 0, t)
    let mut sel_seed: u32 = 0 as u32
    if selected >= 0 { sel_seed = l.cr[selected].seed }
    let look: Look = Look { style: v.style, t: v.clock, day: l.daylight, selected: sel_seed }
    let mut world: Frame = v.a
    if v.flip { world = v.b }
    if v.half and !v.view3d {
        world = v.la
        if v.flip { world = v.lb }
    }
    v.flip = !v.flip
    if v.view3d {
        view3_draw(&v.v3, world, &v.cam3, &v.scene, l, v.clock, v.flow_view, v.style)
    } elif v.half {
        let mut cam: Camera = v.cam
        cam.w = world.w
        cam.h = world.h
        cam.scale = cam.scale * 0.5
        if v.quarter {
            let mut qc: Camera = v.cam
            qc.w = v.q.w
            qc.h = v.q.h
            qc.scale = qc.scale * 0.25
            scene_draw(v.q, &v.scene, &qc, l, v.clock, v.flow_view, v.style)
            fb_upscale2(v.q, world)
            t = vlap(v, 1, t)
            world_2d(v, world, &cam, &v.dl_lo, l, look, false)
        } else {
            world_2d(v, world, &cam, &v.dl_lo, l, look, true)
        }
    } else {
        world_2d(v, world, &v.cam, &v.dl, l, look, true)
    }
    let mut hud: Frame = v.ha
    if !v.hud_flip { hud = v.hb }
    let fresh: bool = force_hud or v.frame_no % v.hud_every == 0
    if fresh {
        v.hud_flip = !v.hud_flip
        hud = v.ha
        if !v.hud_flip { hud = v.hb }
        t = view_ms_c()
        fb_clear(hud)
        hud_draw(hud, &v.hud, l, cs, preset, steps, paused, selected, look, v.view3d, v.flow_view, fps)
        t = vlap(v, 6, t)
    }
    v.frame_no = v.frame_no + 1
    return Shown { world: world, hud: hud, hud_fresh: fresh }
}

# One opaque full-size picture of what view_render made, for stills.
export function view_compose(v: ptr<View>, s: Shown) -> Frame {
    let mut out: Frame = s.world
    if s.world.w != v.w {
        out = v.a
        if s.world.px == v.a.px { out = v.b }
        fb_upscale2(s.world, out)
    }
    fb_over(out, s.hud)
    return out
}

# The world from above: scene, tracers, organisms, effects.
function world_2d(v: ptr<View>, f: Frame, cam: ptr<Camera>, dl: ptr<DrawList>, l: ptr<Life>, look: Look,
                  scene: bool) -> void {
    let mut t: f64 = view_ms_c()
    if scene { scene_draw(f, &v.scene, cam, l, v.clock, v.flow_view, v.style) }
    t = vlap(v, 1, t)
    let ocean: bool = l.cfg.habitat == HAB_OCEAN
    if l.cfg.flow > 0.0 and v.style != STYLE_BRIGHT {
        let mut k: f32 = 0.35 + 0.65 * l.daylight
        if v.flow_view { k = 1.0 }
        if !ocean { k = 0.5 }
        tracers_draw(f, &v.tr, cam, l, k)
    }
    t = vlap(v, 2, t)
    drawlist_build(dl, l, cam)
    t = vlap(v, 7, t)
    if ocean and v.style == STYLE_NATURAL {
        bodies_glow(f, dl, l, cam, 1.0 - l.daylight)
    }
    t = vlap(v, 5, t)
    bodies_draw(f, dl, l, cam, look)
    t = vlap(v, 3, t)
    effects_draw(f, &v.tr, cam)
    t = vlap(v, 4, t)
}

function vlap(v: ptr<View>, k: i32, t0: f64) -> f64 {
    let now: f64 = view_ms_c()
    v.prof[k] = v.prof[k] + (now - t0)
    return now
}

# The organism nearest a screen point, within reach, or -1.
export function view_pick(v: ptr<View>, l: ptr<Life>, sx: f32, sy: f32) -> i32 {
    let mut wx: f32 = 0.0
    let mut wy: f32 = 0.0
    if v.view3d {
        # Where the pointer's ray meets the plane organisms swim in.
        let c: ptr<Cam3> = &v.cam3
        cam3_update(c)
        let ox: f32 = (sx - (c.w as f32) * 0.5) / c.focal
        let oy: f32 = ((c.h as f32) * 0.5 - sy) / c.focal
        let dx: f32 = c.fx + ox * c.rx + oy * c.ux
        let dy: f32 = c.fy + ox * c.ry + oy * c.uy
        let dz: f32 = c.fz + oy * c.uz
        if dz >= 0.0 { return -1 }
        let t: f32 = (c.ez - SWIM_Z) / (0.0 - dz)
        wx = c.ex + dx * t
        wy = c.ey + dy * t
        if c.wrap {
            wx = cam_wrap(wx, WORLD_W as f32)
            wy = cam_wrap(wy, WORLD_H as f32)
        }
    } else {
        wx = cam_wx(&v.cam, sx)
        wy = cam_wy(&v.cam, sy)
    }
    let mut best: i32 = -1
    let mut bd: f32 = 1000000.0
    for i in 0 to l.n {
        let mut dx: f32 = l.cr[i].px - wx
        let mut dy: f32 = l.cr[i].py - wy
        if v.cam.wrap {
            if dx > 128.0 { dx = dx - 256.0 }
            if dx < -128.0 { dx = dx + 256.0 }
            if dy > 128.0 { dy = dy - 256.0 }
            if dy < -128.0 { dy = dy + 256.0 }
        }
        let d: f32 = dx * dx + dy * dy
        let reach: f32 = l.cr[i].radius + 2.0
        if d < bd and d < reach * reach {
            bd = d
            best = i
        }
    }
    return best
}

# Keep the camera on an organism.
export function view_follow(v: ptr<View>, l: ptr<Life>, i: i32) -> void {
    if i < 0 { return }
    if v.view3d {
        let c: ptr<Cam3> = &v.cam3
        let mut dx: f32 = l.cr[i].px - c.tx
        let mut dy: f32 = l.cr[i].py - c.ty
        if c.wrap {
            if dx > 128.0 { dx = dx - 256.0 }
            if dx < -128.0 { dx = dx + 256.0 }
            if dy > 128.0 { dy = dy - 256.0 }
            if dy < -128.0 { dy = dy + 256.0 }
        }
        c.tx = c.tx + 0.12 * dx
        c.ty = c.ty + 0.12 * dy
        if c.wrap {
            c.tx = cam_wrap(c.tx, WORLD_W as f32)
            c.ty = cam_wrap(c.ty, WORLD_H as f32)
        }
    } else {
        cam_follow(&v.cam, l.cr[i].px, l.cr[i].py, 0.12)
    }
}
