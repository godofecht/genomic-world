# The overlay: what is going on, in panels over the world.
#
#   top left      the world: preset, its note, tick, generations,
#                 organisms, body plans, mode, time of day
#   right         community composition over time (stacked), energy by
#                 source, bodies, selection, and the experiment's own
#                 readout (resistance, position along the light, program
#                 length), then the bestiary of the commonest forms
#   bottom left   the selected organism: portrait, life, energy, body,
#                 its brain with live activity, and its developmental
#                 program gene by gene
#   menu          presets, modes and body dimensions, for a new world
#   help          every key
#
# Sizes are in points; `u` converts to pixels (2 on a Retina panel).

import gsim.config
import glife.lconfig
import glife.lgenome
import glife.develop
import glife.brain
import glife.creature
import glife.lworld
import glife.census
import glife.habitat
import .fb
import .typo
import .camera
import .bodies

extern {
    function sqrtf(x: f32) -> f32
    function floorf(x: f32) -> f32
}

const INK: i32 = 0xece6da
const DIM: i32 = 0x9a948a
const FAINT: i32 = 0x5f5a54
const PANEL: i32 = 0x0b0d10
const ACCENT: i32 = 0xf2c46e
const C_GRAZER: i32 = 0x5fb4e6
const C_PRED: i32 = 0xe058c8
const C_AUTO: i32 = 0x55c463
const C_MIXO: i32 = 0xb8d65a

struct Hud {
    u: f32,
    show: bool,
    help: bool,
    menu: bool,
    menu_sel: i32,
    menu_mode: i32,
    menu_dims: i32,
    toast: string,
    toast_t: i32,
    # milliseconds per frame spent simulating and drawing
    sim_ms: f32,
    draw_ms: f32,
    # a draw list for portraits
    dl: DrawList
}

export function hud_new(u: f32, frame_h: i32) -> Hud {
    return Hud { u: u, show: true, help: false, menu: false, menu_sel: 0, menu_mode: MODE_PLAN,
                 menu_dims: 2, toast: "", toast_t: 0, sim_ms: 0.0, draw_ms: 0.0,
                 dl: drawlist_new(frame_h) }
}

function px(h: ptr<Hud>, v: f32) -> i32 {
    return (v * h.u + 0.5) as i32
}

# Draw a line of text; returns the x where it ends.
function text(f: Frame, h: ptr<Hud>, x: i32, y: i32, s: string, face: i32, pt: f32, rgb: i32) -> i32 {
    let mut tr: i32 = 0
    if f.alpha { tr = 1 }
    return x + typo_line(f.px, f.w, f.h, x, y, s, face, px(h, pt), rgb, 255, 1, tr)
}

function text_w(f: Frame, h: ptr<Hud>, s: string, face: i32, pt: f32) -> i32 {
    return typo_line(f.px, f.w, f.h, 0, 0, s, face, px(h, pt), 0, 255, 0, 0)
}

# A label and a value side by side; returns the x after them.
function stat(f: Frame, h: ptr<Hud>, x: i32, y: i32, label: string, value: string) -> i32 {
    let a: i32 = text(f, h, x, y, label, FACE_TEXT, 10.5, DIM)
    let b: i32 = text(f, h, x, y + px(h, 13.0), value, FACE_MONO, 13.0, INK)
    let mut e: i32 = a
    if b > e { e = b }
    return e + px(h, 16.0)
}

function panel(f: Frame, h: ptr<Hud>, x: i32, y: i32, w: i32, hh: i32) -> void {
    fb_panel(f, x, y, w, hh, 10.0 * h.u, PANEL, 178)
}

function mode_name(mode: i32) -> string {
    if mode == MODE_PLAN { return "Body plan" }
    if mode == MODE_MORPH { return "Morphology" }
    return "Combined"
}

export function role_name(c: ptr<Creature>, i: i32) -> string {
    let r: i32 = trophic_role(c, i)
    if r == ROLE_PREDATOR { return "Predator" }
    if r == ROLE_AUTOTROPH { return "Autotroph" }
    if r == ROLE_MIXOTROPH { return "Mixotroph" }
    if r == ROLE_GRAZER { return "Grazer" }
    return "No mouth"
}

# A line chart of a history ring.
function chart(f: Frame, cs: ptr<Census>, data: ptr<f32>, x: i32, y: i32, w: i32, hh: i32,
               lo: f32, hi: f32, rgb: i32, width: f32) -> void {
    let n: i32 = cs.hist_count
    if n < 2 { return }
    let mut lx: f32 = 0.0
    let mut ly: f32 = 0.0
    for k in 0 to n {
        let idx: i32 = (cs.hist_head - n + k + 256) % 256
        let mut v: f32 = (data[idx] - lo) / (hi - lo)
        if v < 0.0 { v = 0.0 }
        if v > 1.0 { v = 1.0 }
        let sx: f32 = (x as f32) + ((k as f32) / 255.0) * (w as f32)
        let sy: f32 = (y as f32) + (1.0 - v) * ((hh - 2) as f32) + 1.0
        if k > 0 { fb_line(f, lx, ly, sx, sy, width, rgb, 235) }
        lx = sx
        ly = sy
    }
}

# Community composition over time: grazers, predators, mixotrophs,
# autotrophs stacked to one.
function stack_chart(f: Frame, cs: ptr<Census>, x: i32, y: i32, w: i32, hh: i32) -> void {
    fb_rect(f, x, y, w, hh, 0x14171c, 255)
    let n: i32 = cs.hist_count
    if n < 1 { return }
    for col in 0 to w {
        let k: i32 = (col * 255) / w
        if k < n {
            let idx: i32 = (cs.hist_head - n + k + 256) % 256
            let p: f32 = cs.hist_pred[idx]
            let a: f32 = cs.hist_auto[idx]
            let m: f32 = cs.hist_mixo[idx]
            let mut g: f32 = 1.0 - p - a - m
            if g < 0.0 { g = 0.0 }
            let fh: f32 = hh as f32
            let y1: i32 = y + hh - ((g * fh) as i32)
            let y2: i32 = y1 - ((p * fh) as i32)
            let y3: i32 = y2 - ((m * fh) as i32)
            let y4: i32 = y3 - ((a * fh) as i32)
            fb_rect(f, x + col, y1, 1, y + hh - y1, C_GRAZER, 215)
            fb_rect(f, x + col, y2, 1, y1 - y2, C_PRED, 215)
            fb_rect(f, x + col, y3, 1, y2 - y3, C_MIXO, 215)
            fb_rect(f, x + col, y4, 1, y3 - y4, C_AUTO, 215)
        }
    }
}

function legend(f: Frame, h: ptr<Hud>, x: i32, y: i32, rgb: i32, name: string) -> i32 {
    fb_disc(f, (x as f32) + 4.0 * h.u, (y as f32) + 6.5 * h.u, 3.5 * h.u, rgb, 255)
    return text(f, h, x + px(h, 11.0), y, name, FACE_TEXT, 10.5, DIM) + px(h, 10.0)
}

function bar(f: Frame, h: ptr<Hud>, x: i32, y: i32, w: i32, label: string, v: f32, rgb: i32) -> void {
    let a: i32 = text(f, h, x, y, label, FACE_TEXT, 10.5, DIM)
    let bx: i32 = x + px(h, 74.0)
    let bw: i32 = w - px(h, 74.0) - px(h, 40.0)
    fb_panel(f, bx, y + px(h, 3.0), bw, px(h, 7.0), 3.0 * h.u, 0x22262c, 255)
    let mut vv: f32 = v
    if vv > 1.0 { vv = 1.0 }
    if vv > 0.0 {
        fb_panel(f, bx, y + px(h, 3.0), max_i(px(h, 6.0), ((bw as f32) * vv) as i32), px(h, 7.0), 3.0 * h.u, rgb, 255)
    }
    let b: i32 = text(f, h, bx + bw + px(h, 6.0), y - px(h, 1.0), num((v * 100.0) as f64, 0), FACE_MONO, 10.5, INK)
}

# An organism drawn to fit a box, facing right.
export function portrait(f: Frame, dlp: ptr<DrawList>, l: ptr<Life>, i: i32, cx: f32, cy: f32, box: f32, look: Look) -> void {
    let mut r: f32 = l.cr[i].radius + 0.8
    if l.cfg.mode == MODE_MORPH { r = l.cr[i].radius * 2.2 + 0.6 }
    let s: f32 = box * 0.5 / r
    let mut cam: Camera = Camera { cx: 0.0, cy: 0.0, scale: s, w: 1, h: 1, wrap: false }
    let hd: f32 = l.cr[i].hd
    l.cr[i].hd = 0.0
    let mut plain: Look = look
    plain.selected = 0 as u32
    let dl: ptr<DrawList> = dlp
    dl.n = 1
    dl.idx[0] = i
    dl.sx[0] = cx
    dl.sy[0] = cy
    dl.rad[0] = box * 0.5
    let b0: i32 = max_i(0, ((cy - box * 0.5) as i32) / 32)
    let b1: i32 = min_i(dl.bands - 1, ((cy + box * 0.5) as i32) / 32)
    for b in 0 to dl.bands + 1 {
        dl.band_start[b] = 0
    }
    for b in 0 to dl.bands + 1 {
        if b > b1 { dl.band_start[b] = b1 - b0 + 1 } elif b > b0 { dl.band_start[b] = b - b0 }
    }
    for q in 0 to b1 - b0 + 1 {
        dl.items[q] = 0
    }
    bodies_draw(f, dl, l, &cam, plain)
    l.cr[i].hd = hd
}

export function hud_draw(f: Frame, h: ptr<Hud>, l: ptr<Life>, cs: ptr<Census>, preset: i32,
                         steps: i32, paused: bool, selected: i32, look: Look, view3d: bool, flow_view: bool,
                         fps: f32) -> void {
    if h.show {
        hud_top(f, h, l, cs, preset, steps, paused, view3d, fps)
        hud_right(f, h, l, cs, preset, look)
        if selected >= 0 { hud_inspector(f, h, l, selected, look) }
    }
    if h.show { hud_hint(f, h) }
    if h.toast_t > 0 {
        let w: i32 = text_w(f, h, h.toast, FACE_TEXT, 13.0) + px(h, 28.0)
        let x: i32 = (f.w - w) / 2
        let y: i32 = f.h - px(h, 80.0)
        panel(f, h, x, y, w, px(h, 30.0))
        let a: i32 = text(f, h, x + px(h, 14.0), y + px(h, 7.0), h.toast, FACE_TEXT, 13.0, INK)
        h.toast_t = h.toast_t - 1
    }
    if h.menu { hud_menu(f, h, preset) }
    if h.help { hud_help(f, h) }
}

export function hud_toast(h: ptr<Hud>, s: string) -> void {
    h.toast = s
    h.toast_t = 150
}

function hud_top(f: Frame, h: ptr<Hud>, l: ptr<Life>, cs: ptr<Census>, preset: i32, steps: i32,
                 paused: bool, view3d: bool, fps: f32) -> void {
    let x: i32 = px(h, 18.0)
    let y: i32 = px(h, 16.0)
    let w: i32 = px(h, 560.0)
    panel(f, h, x, y, w, px(h, 104.0))
    let mut cx: i32 = x + px(h, 16.0)
    let t1: i32 = text(f, h, cx, y + px(h, 11.0), "Life World", FACE_BOLD, 19.0, INK)
    let t2: i32 = text(f, h, t1 + px(h, 12.0), y + px(h, 16.0), preset_name(preset), FACE_TEXT, 13.0, ACCENT)
    let t3: i32 = text(f, h, cx, y + px(h, 37.0), preset_note(preset), FACE_TEXT, 10.5, DIM)
    let ry: i32 = y + px(h, 58.0)
    cx = stat(f, h, cx, ry, "Tick", num(l.tick as f64, -1))
    cx = stat(f, h, cx, ry, "Generations", num(cs.max_gen as f64, -1))
    cx = stat(f, h, cx, ry, "Organisms", num(l.n as f64, -1))
    cx = stat(f, h, cx, ry, "Forms", num(cs.plans as f64, -1))
    let mut dims: string = "2D bodies"
    if l.cfg.dims == 3 { dims = "3D bodies" }
    cx = stat(f, h, cx, ry, mode_name(l.cfg.mode), dims)
    if l.cfg.sun {
        let d: f32 = l.daylight
        let mut tod: string = "Night"
        if d > 0.66 { tod = "Day" } elif d > 0.05 { tod = "Dusk or dawn" }
        cx = stat(f, h, cx, ry, "Light", tod)
    }
    if l.cfg.transfer_every > 0 {
        cx = stat(f, h, cx, ry, "Transfers", num(l.transfers as f64, -1))
    }
    # Speed and state, top right of the panel.
    let mut st: string = num_fix(steps as f64, -1, "", " ticks per frame")
    if paused { st = "Paused" }
    let sw: i32 = text_w(f, h, st, FACE_TEXT, 10.5)
    let s1: i32 = text(f, h, x + w - sw - px(h, 16.0), y + px(h, 14.0), st, FACE_TEXT, 10.5, DIM)
    let mut vw: string = "2D view"
    if view3d { vw = "3D view" }
    let fs: string = num_fix(fps as f64, 0, "", " fps")
    let tm: string = num_fix(h.sim_ms as f64, 1, "sim ", " ms")
    let td: string = num_fix(h.draw_ms as f64, 1, "draw ", " ms")
    if h.draw_ms > 0.0 {
        let s4: i32 = text(f, h, x + w - text_w(f, h, tm, FACE_TEXT, 10.5) - px(h, 16.0), y + px(h, 56.0), tm, FACE_TEXT, 10.5, FAINT)
        let s5: i32 = text(f, h, x + w - text_w(f, h, td, FACE_TEXT, 10.5) - px(h, 16.0), y + px(h, 70.0), td, FACE_TEXT, 10.5, FAINT)
    }
    let s2: i32 = text(f, h, x + w - text_w(f, h, vw, FACE_TEXT, 10.5) - px(h, 16.0), y + px(h, 28.0), vw, FACE_TEXT, 10.5, FAINT)
    let s3: i32 = text(f, h, x + w - text_w(f, h, fs, FACE_TEXT, 10.5) - px(h, 16.0), y + px(h, 42.0), fs, FACE_TEXT, 10.5, FAINT)
}

function hud_right(f: Frame, h: ptr<Hud>, l: ptr<Life>, cs: ptr<Census>, preset: i32, look: Look) -> void {
    let w: i32 = px(h, 318.0)
    let x: i32 = f.w - w - px(h, 18.0)
    let mut y: i32 = px(h, 16.0)
    let ph: i32 = f.h - px(h, 32.0)
    panel(f, h, x, y, w, ph)
    let ix: i32 = x + px(h, 16.0)
    let iw: i32 = w - px(h, 32.0)
    y = y + px(h, 12.0)
    let a1: i32 = text(f, h, ix, y, "Community", FACE_BOLD, 12.5, INK)
    y = y + px(h, 20.0)
    stack_chart(f, cs, ix, y, iw, px(h, 64.0))
    chart(f, cs, cs.hist_pop, ix, y, iw, px(h, 64.0), 0.0, max_hist(cs, cs.hist_pop) * 1.1 + 1.0, 0xffffff, 1.4 * h.u)
    y = y + px(h, 70.0)
    let mut lx: i32 = legend(f, h, ix, y, C_GRAZER, "Grazers")
    lx = legend(f, h, lx, y, C_PRED, "Predators")
    lx = legend(f, h, lx, y, C_MIXO, "Mixotrophs")
    lx = legend(f, h, lx, y, C_AUTO, "Autotrophs")
    y = y + px(h, 15.0)
    let a2: i32 = text(f, h, ix, y, "White: organisms", FACE_TEXT, 10.0, FAINT)
    y = y + px(h, 24.0)

    let a3: i32 = text(f, h, ix, y, "Energy intake", FACE_BOLD, 12.5, INK)
    y = y + px(h, 20.0)
    bar(f, h, ix, y, iw, "Grazing", cs.f_graze, C_GRAZER)
    y = y + px(h, 15.0)
    bar(f, h, ix, y, iw, "Scavenging", cs.f_scav, 0xb08a5a)
    y = y + px(h, 15.0)
    bar(f, h, ix, y, iw, "Light", cs.f_photo, C_AUTO)
    y = y + px(h, 15.0)
    bar(f, h, ix, y, iw, "Prey", cs.f_meat, C_PRED)
    y = y + px(h, 24.0)

    let a4: i32 = text(f, h, ix, y, "Bodies and genomes", FACE_BOLD, 12.5, INK)
    y = y + px(h, 20.0)
    let mut sx: i32 = stat(f, h, ix, y, "Cells, mean", num(cs.mean_cells as f64, 1))
    sx = stat(f, h, sx, y, "Largest", num(cs.max_cells as f64, -1))
    sx = stat(f, h, sx, y, "Speed", num(cs.mean_speed as f64, 2))
    y = y + px(h, 34.0)
    sx = stat(f, h, ix, y, "Program genes", num(cs.mean_prog as f64, 2))
    sx = stat(f, h, sx, y, "Most", num(cs.max_prog as f64, -1))
    sx = stat(f, h, sx, y, "Defence", num(cs.mean_armor as f64, 2))
    y = y + px(h, 36.0)
    let ch: i32 = px(h, 34.0)
    # The experiment's own measure.
    if preset == P_MEGAPLATE {
        let a5: i32 = text(f, h, ix, y, "Resistance, mean and highest", FACE_TEXT, 10.5, DIM)
        y = y + px(h, 14.0)
        fb_rect(f, ix, y, iw, ch, 0x14171c, 255)
        chart(f, cs, cs.hist_resist, ix, y, iw, ch, 0.0, 1.0, 0xf07a7a, 1.4 * h.u)
        let a6: i32 = text(f, h, ix + iw - px(h, 70.0), y + px(h, 2.0), num_fix((cs.max_resist * 100.0) as f64, 0, "max ", "%"), FACE_MONO, 10.0, INK)
        y = y + ch + px(h, 10.0)
    } elif preset == P_PHOTOTAXIS {
        let a5: i32 = text(f, h, ix, y, "Mean position toward the lamp", FACE_TEXT, 10.5, DIM)
        y = y + px(h, 14.0)
        fb_rect(f, ix, y, iw, ch, 0x14171c, 255)
        chart(f, cs, cs.hist_x, ix, y, iw, ch, 0.0, 256.0, 0xf2d36e, 1.4 * h.u)
        y = y + ch + px(h, 10.0)
    } else {
        let a5: i32 = text(f, h, ix, y, "Program genes, mean (gene duplication)", FACE_TEXT, 10.5, DIM)
        y = y + px(h, 14.0)
        fb_rect(f, ix, y, iw, ch, 0x14171c, 255)
        chart(f, cs, cs.hist_prog, ix, y, iw, ch, 0.0, max_hist(cs, cs.hist_prog) * 1.2 + 1.0, 0x9fd0ff, 1.4 * h.u)
        y = y + ch + px(h, 10.0)
    }
    let a7: i32 = text(f, h, ix, y, "Selection on speed, parents minus all", FACE_TEXT, 10.5, DIM)
    y = y + px(h, 14.0)
    fb_rect(f, ix, y, iw, ch, 0x14171c, 255)
    fb_rect(f, ix, y + ch / 2, iw, 1, 0x3a3f46, 255)
    chart(f, cs, cs.hist_selv, ix, y, iw, ch, -0.15, 0.15, 0xf08c46, 1.4 * h.u)
    y = y + ch + px(h, 20.0)

    let a8: i32 = text(f, h, ix, y, "Commonest forms", FACE_BOLD, 12.5, INK)
    y = y + px(h, 20.0)
    let tw: i32 = (iw - px(h, 8.0) * 3) / 4
    let th: i32 = tw + px(h, 30.0)
    for k in 0 to BESTIARY {
        let tx: i32 = ix + (k % 4) * (tw + px(h, 8.0))
        let ty: i32 = y + (k / 4) * (th + px(h, 8.0))
        if ty + th < f.h - px(h, 24.0) {
            fb_panel(f, tx, ty, tw, th, 6.0 * h.u, 0x161a20, 255)
            let i: i32 = cs.top[k]
            if i >= 0 and i < l.n {
                portrait(f, &h.dl, l, i, (tx as f32) + (tw as f32) * 0.5, (ty as f32) + (tw as f32) * 0.5, (tw as f32) * 0.86, look)
                let b1: i32 = text(f, h, tx + px(h, 6.0), ty + tw + px(h, 1.0), num(cs.top_count[k] as f64, -1), FACE_MONO, 10.0, INK)
                let b2: i32 = text(f, h, tx + px(h, 6.0), ty + tw + px(h, 14.0), role_name(l.cr, i), FACE_TEXT, 9.5, DIM)
            }
        }
    }
}

function max_hist(cs: ptr<Census>, data: ptr<f32>) -> f32 {
    let mut m: f32 = 0.0
    let n: i32 = cs.hist_count
    for k in 0 to n {
        let idx: i32 = (cs.hist_head - n + k + 256) % 256
        if data[idx] > m { m = data[idx] }
    }
    return m
}

const IN_NAMES: i32 = 10

function input_name(k: i32) -> string {
    if k == 0 { return "food left" }
    if k == 1 { return "food ahead" }
    if k == 2 { return "food right" }
    if k == 3 { return "prey" }
    if k == 4 { return "threat" }
    if k == 5 { return "energy" }
    if k == 6 { return "light ahead" }
    if k == 7 { return "mate" }
    if k == 8 { return "current" }
    return "bias"
}

function type_name(t: i32) -> string {
    if t == CELL_CORE { return "core" }
    if t == CELL_MOUTH { return "mouth" }
    if t == CELL_MOTOR { return "motor" }
    if t == CELL_EYE { return "eye" }
    if t == CELL_PHOTO { return "photosynthetic" }
    if t == CELL_ARMOR { return "armour" }
    if t == CELL_SPIKE { return "spike" }
    return "store"
}

function wcol(w: f32) -> i32 {
    if w >= 0.0 { return 0x6ec8ff }
    return 0xff7a5a
}

function hud_inspector(f: Frame, h: ptr<Hud>, l: ptr<Life>, i: i32, look: Look) -> void {
    let w: i32 = px(h, 560.0)
    let hh: i32 = px(h, 330.0)
    let x: i32 = px(h, 18.0)
    let y: i32 = f.h - hh - px(h, 46.0)
    panel(f, h, x, y, w, hh)
    let c: Creature = l.cr[i]
    let ix: i32 = x + px(h, 16.0)
    let box: f32 = 150.0 * h.u
    fb_panel(f, ix, y + px(h, 14.0), box as i32, box as i32, 8.0 * h.u, 0x13161b, 255)
    portrait(f, &h.dl, l, i, (ix as f32) + box * 0.5, (y as f32) + 14.0 * h.u + box * 0.5, box * 0.9, look)
    let tx: i32 = ix + (box as i32) + px(h, 16.0)
    let mut ty: i32 = y + px(h, 12.0)
    let t1: i32 = text(f, h, tx, ty, role_name(l.cr, i), FACE_BOLD, 15.0, INK)
    let t2: i32 = text(f, h, t1 + px(h, 10.0), ty + px(h, 4.0), num_fix(c.seed as f64, -1, "No. ", ""), FACE_MONO, 10.5, FAINT)
    ty = ty + px(h, 24.0)
    let mut sx: i32 = stat(f, h, tx, ty, "Age", num(c.age as f64, -1))
    sx = stat(f, h, sx, ty, "Generation", num(c.gen as f64, -1))
    sx = stat(f, h, sx, ty, "Cells", num(c.bn as f64, -1))
    sx = stat(f, h, sx, ty, "Kills", num(c.kills as f64, -1))
    ty = ty + px(h, 34.0)
    sx = stat(f, h, tx, ty, "Top speed", num(c.vmax as f64, 2))
    sx = stat(f, h, sx, ty, "Attack", num(c.attack as f64, 1))
    sx = stat(f, h, sx, ty, "Defence", num(c.defense as f64, 1))
    sx = stat(f, h, sx, ty, "Light use", num(c.photo as f64, 1))
    ty = ty + px(h, 36.0)
    bar(f, h, tx, ty, w - (tx - x) - px(h, 10.0), "Energy", c.en / c.ecap, ACCENT)
    ty = ty + px(h, 16.0)
    bar(f, h, tx, ty, w - (tx - x) - px(h, 10.0), "Resistance", c.resist, 0xf07a7a)

    # The brain: inputs left, hidden neurons (with self loops) middle,
    # outputs right. Edge colour is sign, width is strength; node fill is
    # the current activity where it is known.
    let by: i32 = y + px(h, 176.0)
    let bx0: f32 = (ix as f32) + 70.0 * h.u
    let bx1: f32 = (ix as f32) + 250.0 * h.u
    let bx2: f32 = (ix as f32) + 400.0 * h.u
    let gap: f32 = 13.5 * h.u
    let wb: i32 = i * BRAIN_W
    let hid: array<f32, 4> = [c.h0, c.h1, c.h2, c.h3]
    for j in 0 to BRAIN_HID {
        let hy: f32 = (by as f32) + (2.5 + 2.0 * (j as f32)) * gap
        for k in 0 to BRAIN_IN {
            let iy: f32 = (by as f32) + (k as f32) * gap
            let wv: f32 = l.brain[wb + brain_w_in(j, k)]
            if abs_f(wv) > 0.3 {
                fb_line(f, bx0, iy, bx1, hy, 0.4 * h.u * abs_f(wv), wcol(wv), 150)
            }
        }
    }
    for o in 0 to 2 {
        let oy: f32 = (by as f32) + (3.0 + 3.0 * (o as f32)) * gap
        for k in 0 to BRAIN_IN {
            let iy: f32 = (by as f32) + (k as f32) * gap
            let wv: f32 = l.brain[wb + brain_w_out(o, k)]
            if abs_f(wv) > 0.3 {
                fb_line(f, bx0, iy, bx2, oy, 0.4 * h.u * abs_f(wv), wcol(wv), 110)
            }
        }
        for j in 0 to BRAIN_HID {
            let hy: f32 = (by as f32) + (2.5 + 2.0 * (j as f32)) * gap
            let wv: f32 = l.brain[wb + BW_OUT + o * BW_ROW + BRAIN_IN + j]
            if abs_f(wv) > 0.3 {
                fb_line(f, bx1, hy, bx2, oy, 0.4 * h.u * abs_f(wv), wcol(wv), 170)
            }
        }
    }
    for k in 0 to BRAIN_IN {
        let iy: f32 = (by as f32) + (k as f32) * gap
        fb_disc(f, bx0, iy, 3.5 * h.u, 0x2a3038, 255)
        let nm: string = input_name(k)
        let a: i32 = text(f, h, (bx0 as i32) - text_w(f, h, nm, FACE_TEXT, 9.5) - px(h, 8.0), (iy as i32) - px(h, 6.5), nm, FACE_TEXT, 9.5, DIM)
    }
    for j in 0 to BRAIN_HID {
        let hy: f32 = (by as f32) + (2.5 + 2.0 * (j as f32)) * gap
        let act: f32 = hid[j]
        fb_ring(f, bx1 + 7.0 * h.u, hy - 5.0 * h.u, 5.0 * h.u, 1.0 * h.u, wcol(l.brain[wb + BW_HH + j]), 160)
        fb_disc(f, bx1, hy, 5.0 * h.u, 0x2a3038, 255)
        fb_disc(f, bx1, hy, 5.0 * h.u * abs_f(act), wcol(act), 255)
    }
    let outs: array<f32, 2> = [c.turn, c.thrust]
    for o in 0 to 2 {
        let oy: f32 = (by as f32) + (3.0 + 3.0 * (o as f32)) * gap
        fb_disc(f, bx2, oy, 6.0 * h.u, 0x2a3038, 255)
        fb_disc(f, bx2, oy, 6.0 * h.u * abs_f(outs[o]), ACCENT, 255)
        let mut nm: string = "turn"
        if o == 1 { nm = "thrust" }
        let a: i32 = text(f, h, (bx2 as i32) + px(h, 10.0), (oy as i32) - px(h, 6.5), nm, FACE_TEXT, 9.5, DIM)
    }
    let a8: i32 = text(f, h, (bx1 as i32) - px(h, 26.0), by - px(h, 16.0), "memory", FACE_TEXT, 9.0, FAINT)

    if l.cfg.mode == MODE_MORPH {
        morph_traits(f, h, l, i, ix + px(h, 440.0), by - px(h, 16.0), y + hh)
        return
    }
    # The developmental program: one block per cell-identity gene, in the
    # colour of the cell type it makes, ticked where it grows.
    let gx: i32 = ix + px(h, 440.0)
    let gy: i32 = by - px(h, 16.0)
    let a9: i32 = text(f, h, gx, gy, "Program", FACE_TEXT, 9.5, FAINT)
    let g: ptr<u32> = l.genome
    let gb: i32 = i * L_WORDS
    let mut k: i32 = g[prog_at(gb, 0)] as i32
    let kb: i32 = g[prog_at(gb, 1)] as i32
    if kb > k { k = kb }
    let cell: i32 = px(h, 13.0)
    for q in 0 to k {
        let col: i32 = q % 6
        let row: i32 = q / 6
        let qx: i32 = gx + col * (cell + px(h, 3.0))
        let qy: i32 = gy + px(h, 16.0) + row * (cell + px(h, 3.0))
        if qy + cell < y + hh {
            let mut p: i32 = prog_at(gb, 0)
            if q >= (g[p] as i32) { p = prog_at(gb, 1) }
            let w0: u32 = g[p + 1 + 2 * q]
            let w1: u32 = g[p + 2 + 2 * q]
            let t: i32 = gene_field(w0, 0, 3) + 1
            fb_panel(f, qx, qy, cell, cell, 2.5 * h.u, type_rgb(t, c.col), 235)
            let mut grows: i32 = 0
            for d in 0 to 6 {
                if (gene_dir(w0, w1, d) & 64) != 0 { grows = grows + 1 }
            }
            for d in 0 to grows {
                fb_rect(f, qx + px(h, 2.0) + d * px(h, 2.0), qy + cell - px(h, 3.0), px(h, 1.0), px(h, 2.0), 0x101010, 255)
            }
        }
    }
    let a10: i32 = text(f, h, gx, y + hh - px(h, 22.0), num_fix(k as f64, -1, "", " genes"), FACE_MONO, 10.0, DIM)
}

# A unicellular organism's morphological genes as small bars.
function morph_traits(f: Frame, h: ptr<Hud>, l: ptr<Life>, i: i32, x: i32, y: i32, bottom: i32) -> void {
    let m: Morph = l.looks[i]
    let a: i32 = text(f, h, x, y, "Genes", FACE_TEXT, 9.5, FAINT)
    let vals: array<f32, 11> = [m.size, m.elong, (m.flag_n as f32) / 7.0, m.flag_l, m.cilia, m.chloro,
                                m.mouth, m.raptor, (m.spine_n as f32) * m.spine_l / 15.0, m.membrane, m.eyespot]
    let w: i32 = px(h, 100.0)
    for k in 0 to 11 {
        let yy: i32 = y + px(h, 16.0) + k * px(h, 12.0)
        if yy + px(h, 10.0) < bottom {
            let b: i32 = text(f, h, x, yy - px(h, 2.0), trait_name(k), FACE_TEXT, 8.5, DIM)
            let bx: i32 = x + px(h, 52.0)
            fb_panel(f, bx, yy + px(h, 2.0), w - px(h, 52.0), px(h, 5.0), 2.0 * h.u, 0x22262c, 255)
            let mut v: f32 = vals[k]
            if v > 1.0 { v = 1.0 }
            if v > 0.0 {
                fb_panel(f, bx, yy + px(h, 2.0), max_i(px(h, 4.0), (((w - px(h, 52.0)) as f32) * v) as i32), px(h, 5.0), 2.0 * h.u, pigment(m), 255)
            }
        }
    }
}

function trait_name(k: i32) -> string {
    if k == 0 { return "size" }
    if k == 1 { return "length" }
    if k == 2 { return "flagella" }
    if k == 3 { return "flag. length" }
    if k == 4 { return "cilia" }
    if k == 5 { return "chlorophyll" }
    if k == 6 { return "cytostome" }
    if k == 7 { return "raptorial" }
    if k == 8 { return "spines" }
    if k == 9 { return "membrane" }
    return "eyespot"
}

function hud_hint(f: Frame, h: ptr<Hud>) -> void {
    let s: string = "H help    Tab new world    Space pause    [ ] speed    V style    G quality    3 view    click to follow"
    let w: i32 = text_w(f, h, s, FACE_TEXT, 10.5) + px(h, 24.0)
    let y: i32 = f.h - px(h, 34.0)
    fb_panel(f, px(h, 18.0), y, w, px(h, 22.0), 8.0 * h.u, PANEL, 150)
    let a: i32 = text(f, h, px(h, 30.0), y + px(h, 5.0), s, FACE_TEXT, 10.5, DIM)
}

function key_row(f: Frame, h: ptr<Hud>, x: i32, y: i32, k: string, what: string) -> void {
    let a: i32 = text(f, h, x, y, k, FACE_MONO, 12.0, ACCENT)
    let b: i32 = text(f, h, x + px(h, 130.0), y, what, FACE_TEXT, 12.0, INK)
}

function hud_help(f: Frame, h: ptr<Hud>) -> void {
    let w: i32 = px(h, 560.0)
    let hh: i32 = px(h, 494.0)
    let x: i32 = (f.w - w) / 2
    let y: i32 = (f.h - hh) / 2
    fb_panel(f, x, y, w, hh, 14.0 * h.u, 0x07080a, 236)
    let ix: i32 = x + px(h, 28.0)
    let mut ky: i32 = y + px(h, 24.0)
    let t: i32 = text(f, h, ix, ky, "Keys", FACE_BOLD, 18.0, INK)
    ky = ky + px(h, 38.0)
    key_row(f, h, ix, ky, "Tab", "choose a world: preset, mode, 2D or 3D bodies")
    ky = ky + px(h, 22.0)
    key_row(f, h, ix, ky, "Space", "pause and resume")
    ky = ky + px(h, 22.0)
    key_row(f, h, ix, ky, "[  ]", "fewer or more ticks per frame")
    ky = ky + px(h, 22.0)
    key_row(f, h, ix, ky, "wheel, drag", "zoom and pan; in 3D, right-drag turns")
    ky = ky + px(h, 22.0)
    key_row(f, h, ix, ky, "click", "follow an organism; Esc lets go")
    ky = ky + px(h, 22.0)
    key_row(f, h, ix, ky, "3", "2D or 3D view")
    ky = ky + px(h, 22.0)
    key_row(f, h, ix, ky, "V", "pixels, natural, bright-field or dark-field")
    ky = ky + px(h, 22.0)
    key_row(f, h, ix, ky, "F", "show the flow")
    ky = ky + px(h, 22.0)
    key_row(f, h, ix, ky, "I", "hide or show the panels")
    ky = ky + px(h, 22.0)
    key_row(f, h, ix, ky, "O", "open or close the ocean's passes")
    ky = ky + px(h, 22.0)
    key_row(f, h, ix, ky, "W", "warm or cool the climate")
    ky = ky + px(h, 22.0)
    key_row(f, h, ix, ky, "R", "same world, new seed")
    ky = ky + px(h, 22.0)
    key_row(f, h, ix, ky, "Z", "whole world in view")
    ky = ky + px(h, 22.0)
    key_row(f, h, ix, ky, "G", "quality: fast, balanced or full resolution")
    ky = ky + px(h, 22.0)
    key_row(f, h, ix, ky, "Return", "full screen on or off")
    ky = ky + px(h, 22.0)
    key_row(f, h, ix, ky, "Esc, Q", "leave full screen; Q quits")
}

function hud_menu(f: Frame, h: ptr<Hud>, preset: i32) -> void {
    let w: i32 = px(h, 640.0)
    let hh: i32 = px(h, 420.0)
    let x: i32 = (f.w - w) / 2
    let y: i32 = (f.h - hh) / 2
    fb_panel(f, x, y, w, hh, 14.0 * h.u, 0x07080a, 240)
    let ix: i32 = x + px(h, 28.0)
    let mut ky: i32 = y + px(h, 22.0)
    let t: i32 = text(f, h, ix, ky, "A new world", FACE_BOLD, 18.0, INK)
    let t2: i32 = text(f, h, ix + px(h, 140.0), ky + px(h, 5.0), "Up and down choose, Return starts, Tab closes", FACE_TEXT, 10.5, DIM)
    ky = ky + px(h, 38.0)
    for p in 0 to P_COUNT {
        let sel: bool = p == h.menu_sel
        if sel {
            fb_panel(f, ix - px(h, 10.0), ky - px(h, 4.0), w - px(h, 36.0), px(h, 34.0), 7.0 * h.u, 0x1d2229, 255)
        }
        let mut c: i32 = DIM
        if sel { c = INK }
        let a: i32 = text(f, h, ix, ky, preset_name(p), FACE_BOLD, 12.5, c)
        let b: i32 = text(f, h, ix, ky + px(h, 15.0), preset_note(p), FACE_TEXT, 9.5, FAINT)
        ky = ky + px(h, 36.0)
    }
    ky = ky + px(h, 4.0)
    let m1: i32 = text(f, h, ix, ky, "Organisms (M)", FACE_TEXT, 11.0, DIM)
    let m2: i32 = text(f, h, ix + px(h, 110.0), ky, mode_name(h.menu_mode), FACE_BOLD, 11.0, ACCENT)
    let mut dn: string = "2D bodies"
    if h.menu_dims == 3 { dn = "3D bodies" }
    let m3: i32 = text(f, h, ix + px(h, 260.0), ky, "Bodies (D)", FACE_TEXT, 11.0, DIM)
    let m4: i32 = text(f, h, ix + px(h, 340.0), ky, dn, FACE_BOLD, 11.0, ACCENT)
}
