# Run the spatial model headless and export a random sample: sample.vcf,
# sample.tsv and loci.tsv in GW_OUT (default out). GW_TICKS (default 3000)
# and GW_SAMPLE (default 1000) set the run length and sample size; every
# other GW_ variable in sim/params.flow applies too.
#
# Run: ./run.sh export
#      GW_SEED=7 GW_PASSES=0 GW_OUT=out/closed ./run.sh export

import gsim.config
import gsim.state
import gsim.step
import gsim.params
import gsim.stats
import gsim.sampling

extern {
    function getenv(name: string) -> ptr<u8>
    function atoi(s: ptr<u8>) -> i32
}

function env_int(name: string, fallback: i32) -> i32 {
    let v: ptr<u8> = getenv(name)
    if v == null { return fallback }
    return atoi(v)
}

function main() -> i32 {
    let mut w: World = sim_init(params_seed(20261013 as u32))
    let mut s: Stats = stats_alloc()
    let ticks: i32 = env_int("GW_TICKS", 3000)
    let want: i32 = env_int("GW_SAMPLE", 1000)
    for t in 0 to ticks {
        sim_step(&w)
    }
    stats_compute(&s, &w)
    let k: i32 = export_sample(&w, &s, want)
    printf("tick %d, population %d, exported %d individuals\n", w.tick as i32, w.n, k)
    printf("  written to %s: sample.vcf sample.tsv loci.tsv\n", params_out_dir())
    if k == 0 { return 1 }
    return 0
}
