# Headless run: advances the world without graphics, prints the
# population-genetic state every 250 ticks, then throughput and the time
# spent in each phase of the tick.
#
# Run: ./run.sh bench
#      OMP_NUM_THREADS=1 ./run.sh bench    serial baseline

import "stdlib/experiment.flow"
import gsim.config
import gsim.state
import gsim.step
import gsim.stats

extern {
    function omp_get_max_threads() -> i32
}

const BENCH_TICKS: i32 = 3000
const REPORT_EVERY: i32 = 250

function main() -> i32 {
    let mut w: World = sim_init(20261013 as u32)
    let mut s: Stats = stats_alloc()
    let mut phase_ns: array<i64, 8> = [0, 0, 0, 0, 0, 0, 0, 0]
    printf("threads %d\n", omp_get_max_threads())
    printf(" tick    pop  births  starved  adapt_r    F_ST  H_mark  burden  ms/tick\n")
    let mut agent_ticks: f64 = 0.0
    let t_start: i64 = xp_now_ns()
    let mut t_last: i64 = t_start
    for t in 0 to BENCH_TICKS {
        agent_ticks = agent_ticks + (w.n as f64)
        for k in 0 to PHASES {
            let a: i64 = xp_now_ns()
            sim_phase(&w, k)
            phase_ns[k] = phase_ns[k] + (xp_now_ns() - a)
        }
        if (t + 1) % REPORT_EVERY == 0 {
            let now: i64 = xp_now_ns()
            let ms: f64 = ((now - t_last) as f64) / 1000000.0 / (REPORT_EVERY as f64)
            stats_compute(&s, &w)
            t_last = xp_now_ns()
            printf("%5d %6d %7d %8d %8.3f %7.4f %7.4f %7.3f %8.3f\n",
                   t + 1, w.n, w.births, w.starved, s.adapt_r as f64,
                   s.fst as f64, s.het as f64, s.mean_burden as f64, ms)
        }
        if w.n == 0 {
            printf("extinct at tick %d\n", t)
            return 1
        }
    }
    let secs: f64 = ((xp_now_ns() - t_start) as f64) / 1000000000.0
    printf("\n%d ticks in %.2f s: %.1f ticks/s, %.2f M agent-ticks/s\n",
           BENCH_TICKS, secs, (BENCH_TICKS as f64) / secs, agent_ticks / secs / 1000000.0)
    let mut total: i64 = 0
    for k in 0 to PHASES {
        total = total + phase_ns[k]
    }
    for k in 0 to PHASES {
        printf("  %-10s %7.3f ms/tick  %5.1f%%\n", phase_name(k),
               (phase_ns[k] as f64) / 1000000.0 / (BENCH_TICKS as f64),
               100.0 * (phase_ns[k] as f64) / (total as f64))
    }
    printf("state hash %u\n", sim_state_hash(&w))
    return 0
}
