# The whole simulation state in one record.
#
# Agents are stored as structure of arrays: one array per field, indexed by
# slot. Slots 0 to n-1 are alive and packed; compaction keeps them in birth
# order, which is also the order agents eat in within a cell.

import .config
import .climate
import .genome

# The agent columns, as a unit. World holds the live set inline and a second
# set in `back`; compaction scatters survivors into back, then swaps.
struct Agents {
    px: ptr<f32>,
    py: ptr<f32>,
    hd: ptr<f32>,
    en: ptr<f32>,
    age: ptr<i32>,
    cd: ptr<i32>,
    seed_of: ptr<u32>,
    topt: ptr<f32>,
    spd: ptr<f32>,
    size: ptr<f32>,
    thr: ptr<f32>,
    sense: ptr<i32>,
    load: ptr<i32>,
    col: ptr<u32>,
    genome: ptr<u32>,
    gtopt: ptr<f32>,
    mid: ptr<f32>,
    bx: ptr<f32>,
    by: ptr<f32>,
    viab: ptr<f32>,
    kids: ptr<f32>
}

struct World {
    tick: u32,
    seed: u32,
    n: i32,
    climate: Climate,
    passes_open: bool,
    warming_dir: i32,

    # genetics and selection
    arch: Arch,
    thermal_cost: f32,
    mortality: f32,

    # field, WORLD_CELLS each
    food: ptr<f32>,
    fert: ptr<f32>,
    terrain: ptr<u8>,
    zone: ptr<u8>,
    temp_row: ptr<f32>,

    # agents, N_MAX each
    px: ptr<f32>,
    py: ptr<f32>,
    hd: ptr<f32>,
    en: ptr<f32>,
    age: ptr<i32>,
    cd: ptr<i32>,
    seed_of: ptr<u32>,
    topt: ptr<f32>,
    spd: ptr<f32>,
    size: ptr<f32>,
    thr: ptr<f32>,
    sense: ptr<i32>,
    load: ptr<i32>,
    col: ptr<u32>,
    genome: ptr<u32>,
    gtopt: ptr<f32>,
    mid: ptr<f32>,
    bx: ptr<f32>,
    by: ptr<f32>,
    viab: ptr<f32>,
    kids: ptr<f32>,
    back: Agents,
    slot_dst: ptr<i32>,

    # spatial index, rebuilt every tick
    cell_of: ptr<i32>,
    cell_start: ptr<i32>,
    cell_fill: ptr<i32>,
    order: ptr<i32>,

    # per tick counters
    births: i32,
    stillborn: i32,
    starved: i32,
    old_age: i32,
    killed: i32,
    pending: i32,
    next_seed: u32,

    # running estimates, exponential moving averages over births
    gen_time: f32,
    disp2: f32,
    disp2_x: f32,
    disp2_y: f32,
    land_cells: i32,

    # Selection calibration: at each death, lifetime offspring are binned by
    # thermal mismatch at the birthplace. Read by sim/calibrate.flow.
    cal_on: bool,
    cal_n: ptr<f64>,
    cal_kids: ptr<f64>,
    cal_d2: ptr<f64>
}
