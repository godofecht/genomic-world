# A CPU framebuffer with rectangles, text and numbers.
#
# The whole window is drawn here and blitted once per frame. Drawing text
# through gfx_fill_rect costs one native call per glyph pixel; writing the
# same pixels into a buffer costs a store each.

import "stdlib/memory.flow"
import "stdlib/font.flow"

struct Canvas {
    w: i32,
    h: i32,
    px: ptr<u8>
}

export function canvas_new(w: i32, h: i32) -> Canvas {
    return Canvas { w: w, h: h, px: alloc_zeroed((w as i64) * (h as i64) * 3) as ptr<u8> }
}

export function cv_put(cv: Canvas, x: i32, y: i32, r: i32, g: i32, b: i32) -> void {
    if x < 0 or y < 0 or x >= cv.w or y >= cv.h { return }
    let o: i32 = (y * cv.w + x) * 3
    cv.px[o] = r as u8
    cv.px[o + 1] = g as u8
    cv.px[o + 2] = b as u8
}

export function cv_rect(cv: Canvas, x: i32, y: i32, w: i32, h: i32, r: i32, g: i32, b: i32) -> void {
    let mut x0: i32 = x
    let mut y0: i32 = y
    let mut x1: i32 = x + w
    let mut y1: i32 = y + h
    if x0 < 0 { x0 = 0 }
    if y0 < 0 { y0 = 0 }
    if x1 > cv.w { x1 = cv.w }
    if y1 > cv.h { y1 = cv.h }
    let rr: u8 = r as u8
    let gg: u8 = g as u8
    let bb: u8 = b as u8
    for yy in y0 to y1 {
        let mut o: i32 = (yy * cv.w + x0) * 3
        for xx in x0 to x1 {
            cv.px[o] = rr
            cv.px[o + 1] = gg
            cv.px[o + 2] = bb
            o = o + 3
        }
    }
}

export function cv_char(cv: Canvas, x: i32, y: i32, ch: i32, r: i32, g: i32, b: i32) -> i32 {
    for row in 0 to 7 {
        let bits: i32 = font_glyph_row(ch, row) as i32
        if bits != 0 {
            for col in 0 to 5 {
                if ((bits >> (4 - col)) & 1) == 1 {
                    cv_put(cv, x + col, y + row, r, g, b)
                }
            }
        }
    }
    return 6
}

export function cv_text(cv: Canvas, x: i32, y: i32, s: string, r: i32, g: i32, b: i32) -> i32 {
    let bytes: ptr<u8> = s as ptr<u8>
    let mut i: i32 = 0
    let mut pen: i32 = x
    while bytes[i] != 0 {
        pen = pen + cv_char(cv, pen, y, bytes[i] as i32, r, g, b)
        i = i + 1
    }
    return pen
}

export function cv_int(cv: Canvas, x: i32, y: i32, n: i32, r: i32, g: i32, b: i32) -> i32 {
    let mut pen: i32 = x
    let mut v: i32 = n
    if v < 0 {
        pen = pen + cv_char(cv, pen, y, 45, r, g, b)
        v = 0 - v
    }
    let mut div: i32 = 1
    while div <= v / 10 {
        div = div * 10
    }
    while div > 0 {
        let d: i32 = (v / div) % 10
        pen = pen + cv_char(cv, pen, y, 48 + d, r, g, b)
        div = div / 10
    }
    return pen
}

# Fixed-point decimal: value rounded to `decimals` places.
export function cv_fixed(cv: Canvas, x: i32, y: i32, value: f32, decimals: i32, r: i32, g: i32, b: i32) -> i32 {
    let mut scale: i32 = 1
    for k in 0 to decimals {
        scale = scale * 10
    }
    let mut v: f32 = value
    let mut pen: i32 = x
    if v < 0.0 {
        pen = pen + cv_char(cv, pen, y, 45, r, g, b)
        v = 0.0 - v
    }
    let q: i32 = (v * (scale as f32) + 0.5) as i32
    pen = cv_int(cv, pen, y, q / scale, r, g, b)
    if decimals > 0 {
        pen = pen + cv_char(cv, pen, y, 46, r, g, b)
        let frac: i32 = q % scale
        let mut div: i32 = scale / 10
        while div > 0 {
            pen = pen + cv_char(cv, pen, y, 48 + (frac / div) % 10, r, g, b)
            div = div / 10
        }
    }
    return pen
}
