# Genome layout, expression and meiosis.
#
# Each organism is diploid with four chromosomes. A chromosome is one 32-bit
# word with one biallelic locus per bit. Words 0-3 are one homolog set and
# words 4-7 the other, so chromosome c is the pair (word c, word c + 4).
#
#   chr 0  bits  0-15  thermal optimum   16 additive loci
#          bits 16-31  speed             16 additive loci
#   chr 1  bits  0-15  sensing range
#          bits 16-31  body size
#   chr 2  bits  0-15  reproduction threshold
#          bits 16-31  housekeeping loci, allele 1 is recessive deleterious
#   chr 3  bits  0-29  neutral markers, three blocks of ten read as colour
#          bits 30-31  neutral
#
# A trait is the dosage of allele 1 over its sixteen loci on both homologs,
# 0 to 32, scaled into the trait's range. Loci sharing a chromosome are
# linked, so selection on thermal optimum carries speed alleles with it.

import .config
import .bits
import .rng

export function gen_dosage(a: u32, b: u32, mask: u32) -> i32 {
    return popcount32(a & mask) + popcount32(b & mask)
}

# Trait value in [0, 1] for a sixteen-locus block.
export function gen_block01(g: ptr<u32>, base: i32, chrom: i32, mask: u32) -> f32 {
    let d: i32 = gen_dosage(g[base + chrom], g[base + chrom + CHROMS], mask)
    return (d as f32) * (1.0 / 32.0)
}

export function gen_thermal(g: ptr<u32>, base: i32) -> f32 {
    return gen_block01(g, base, 0, MASK_LO16)
}

# Cells per tick.
export function gen_speed(g: ptr<u32>, base: i32) -> f32 {
    return 0.15 + 1.05 * gen_block01(g, base, 0, MASK_HI16)
}

# Sensing radius in cells, 1 to 5.
export function gen_sense(g: ptr<u32>, base: i32) -> i32 {
    let t: f32 = gen_block01(g, base, 1, MASK_LO16)
    return 1 + ((t * 4.0 + 0.5) as i32)
}

export function gen_size(g: ptr<u32>, base: i32) -> f32 {
    return 0.55 + 1.3 * gen_block01(g, base, 1, MASK_HI16)
}

# Energy needed to breed, as a multiple of body size.
export function gen_repro(g: ptr<u32>, base: i32) -> f32 {
    return 0.7 + 1.4 * gen_block01(g, base, 2, MASK_LO16)
}

# Housekeeping loci homozygous for the deleterious allele.
export function gen_load(g: ptr<u32>, base: i32) -> i32 {
    return popcount32(g[base + 2] & g[base + 6] & MASK_HI16)
}

# Deleterious alleles carried in either state, homozygous loci counted twice.
export function gen_burden(g: ptr<u32>, base: i32) -> i32 {
    return gen_dosage(g[base + 2], g[base + 6], MASK_HI16)
}

# Marker colour as packed 0xRRGGBB. Each channel is the dosage of a ten-locus
# block, so hybrids sit between their parents in colour.
export function gen_color(g: ptr<u32>, base: i32) -> u32 {
    let a: u32 = g[base + 3]
    let b: u32 = g[base + 7]
    let r: i32 = 50 + (gen_dosage(a, b, MASK_MARK_R) * 205) / 20
    let gg: i32 = 50 + (gen_dosage(a, b, MASK_MARK_G) * 205) / 20
    let bb: i32 = 50 + (gen_dosage(a, b, MASK_MARK_B) * 205) / 20
    return ((r as u32) << 16) | ((gg as u32) << 8) | (bb as u32)
}

# Poisson draw by inversion. p0 is exp(-lambda), precomputed by the caller.
export function gen_poisson(st: ptr<u32>, lambda: f32, p0: f32) -> i32 {
    let u: f32 = rng_unit(st)
    let mut k: i32 = 0
    let mut p: f32 = p0
    let mut cdf: f32 = p0
    while u > cdf and k < 16 {
        k = k + 1
        p = p * lambda / (k as f32)
        cdf = cdf + p
    }
    return k
}

# One chromosome through meiosis: pick the starting homolog, then with
# probability xover swap to the other homolog at a uniform breakpoint.
export function gen_meiosis_word(h0: u32, h1: u32, st: ptr<u32>, xover: f32) -> u32 {
    let mut first: u32 = h0
    let mut second: u32 = h1
    if (rng_next(st) & (1 as u32)) == (1 as u32) {
        first = h1
        second = h0
    }
    if rng_unit(st) < xover {
        let k: i32 = 1 + rng_below(st, 31)
        let m: u32 = low_mask(k)
        return (first & m) | (second & invert32(m))
    }
    return first
}

# Write one gamete (four words) from parent genome src[sb..sb+8] into
# dst[db..db+4], with recombination and point mutation.
export function gen_gamete(src: ptr<u32>, sb: i32, dst: ptr<u32>, db: i32,
                           st: ptr<u32>, xover: f32, lambda: f32, p0: f32) -> void {
    for c in 0 to CHROMS {
        dst[db + c] = gen_meiosis_word(src[sb + c], src[sb + c + CHROMS], st, xover)
    }
    let muts: i32 = gen_poisson(st, lambda, p0)
    for m in 0 to muts {
        let locus: i32 = rng_below(st, LOCI)
        let w: i32 = locus >> 5
        let b: i32 = locus & 31
        dst[db + w] = dst[db + w] ^ ((1 as u32) << (b as u32))
    }
}

# Child genome at dst[db..db+8] from two parents.
export function gen_cross(mom: ptr<u32>, mb: i32, dad: ptr<u32>, fb: i32,
                          dst: ptr<u32>, db: i32, st: ptr<u32>,
                          xover: f32, lambda: f32, p0: f32) -> void {
    gen_gamete(mom, mb, dst, db, st, xover, lambda, p0)
    gen_gamete(dad, fb, dst, db + CHROMS, st, xover, lambda, p0)
}
