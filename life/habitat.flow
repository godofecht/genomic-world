# Habitats and experiments.
#
# A preset sets up a world the way a laboratory or field setting would:
# its vessel, medium, light, flow, the founders and where they go. Each
# lab preset is a simplified version of a published experiment, so what
# the simulation does can be held against what happened in the real one.
#
#   OCEAN        the open ocean: gyres around ridges and passes, upwelling
#                that drifts, day and night, seasons
#   DISH         a liquid culture in a petri dish under a lamp, gently
#                stirred
#   RANGE        a colony spreading on agar from a central drop of two
#                neutral colour strains, well mixed in the drop. On agar cells hardly move, so
#                the colony grows at its edge, where few cells found each
#                new patch: the strains separate into sectors by drift.
#                Hallatschek, Hersen, Ramanathan and Nelson (2007),
#                "Genetic drift at expanding frontiers promotes gene
#                segregation", PNAS 104: 19926
#   GAUSE        prey and a predator together in a small liquid dish.
#                Gause (1934), "The Struggle for Existence": Didinium ate
#                every Paramecium and then starved
#   REFUGE       the same, with sediment at one side where prey cannot be
#                caught; in Gause's version prey survived there
#   MEGAPLATE    a long agar plate with bands of antibiotic rising toward
#                the middle, inoculated at both ends. Baym, Lieberman,
#                Chase, Gross and Kishony (2016), "Spatiotemporal microbial
#                evolution on antibiotic landscapes", Science 353: 1147:
#                resistance evolves in steps, band by band
#   PHOTOTAXIS   a slide lit from one end; green swimmers with eyespots
#                on poor medium, so light pays
#   TRANSFER     serial transfer into fresh medium, keeping a tenth every
#                600 ticks, as in Lenski's long-term evolution experiment
#                with E. coli (Lenski, Rose, Simpson and Tadler 1991,
#                American Naturalist 138: 1315)

import gsim.config
import gsim.state
import gsim.rng
import gsim.world
import .lconfig
import .lgenome
import .creature
import .lworld

extern {
    function sqrtf(x: f32) -> f32
}

const P_OCEAN: i32 = 0
const P_DISH: i32 = 1
const P_RANGE: i32 = 2
const P_GAUSE: i32 = 3
const P_REFUGE: i32 = 4
const P_MEGAPLATE: i32 = 5
const P_PHOTOTAXIS: i32 = 6
const P_TRANSFER: i32 = 7
const P_COUNT: i32 = 8

export function preset_name(p: i32) -> string {
    if p == P_OCEAN { return "Open ocean" }
    if p == P_DISH { return "Petri dish" }
    if p == P_RANGE { return "Range expansion on agar" }
    if p == P_GAUSE { return "Predator and prey (Gause)" }
    if p == P_REFUGE { return "Predator and prey with a refuge" }
    if p == P_MEGAPLATE { return "MEGA-plate antibiotic gradient" }
    if p == P_PHOTOTAXIS { return "Phototaxis on a slide" }
    return "Serial transfer (Lenski)"
}

export function preset_note(p: i32) -> string {
    if p == P_OCEAN { return "Gyres around ridges, drifting upwelling, day and night" }
    if p == P_DISH { return "Liquid culture under a lamp, gently stirred" }
    if p == P_RANGE { return "Two neutral strains spread from a drop; drift at the front makes sectors (Hallatschek et al. 2007)" }
    if p == P_GAUSE { return "Didinium and Paramecium in a small dish (Gause 1934)" }
    if p == P_REFUGE { return "Sediment at the left edge protects prey (Gause 1934)" }
    if p == P_MEGAPLATE { return "Bands of antibiotic rising to the middle; resistance evolves band by band (Baym et al. 2016)" }
    if p == P_PHOTOTAXIS { return "Lamp at the right end, poor medium; eyespots and chlorophyll pay" }
    return "A tenth moves to fresh medium every 600 ticks (Lenski et al. 1991)"
}

# The mode a preset suggests: lab presets are microbes.
export function preset_mode(p: i32) -> i32 {
    if p == P_OCEAN { return MODE_PLAN }
    return MODE_MORPH
}

export function preset_cfg(p: i32, mode: i32, dims: i32) -> LifeCfg {
    let mut c: LifeCfg = cfg_default()
    c.mode = mode
    c.dims = dims
    if p == P_OCEAN { return c }
    c.thermal = false
    # Microbes divide; protists conjugate now and then.
    c.sex = 0.1
    c.sun = false
    c.lamp = 0.8
    c.upwell = false
    if p == P_DISH {
        c.habitat = HAB_DISH
        c.flow = 0.12
        c.regrow = 0.35
        c.founders = 2000
    } elif p == P_RANGE {
        c.habitat = HAB_DISH
        c.flow = 0.0
        c.viscosity = 0.03
        c.regrow = 0.03
        c.medium = 1.0
        c.founders = 60
        c.found_x = 128.0
        c.found_y = 128.0
        c.found_r = 3.0
        c.groups = 2
        c.mix_groups = true
        c.sex = 0.0
        c.founder_bacterial = true
    } elif p == P_GAUSE or p == P_REFUGE {
        c.habitat = HAB_DISH
        c.flow = 0.05
        c.regrow = 0.5
        c.founders = 1600
    } elif p == P_MEGAPLATE {
        c.habitat = HAB_SLIDE
        c.flow = 0.0
        c.viscosity = 0.35
        c.regrow = 0.3
        c.medium = 1.0
        c.founders = 600
        c.sex = 0.0
        c.founder_bacterial = true
        c.groups = 2
    } elif p == P_PHOTOTAXIS {
        c.habitat = HAB_SLIDE
        c.flow = 0.04
        c.regrow = 0.05
        c.medium = 0.35
        c.founders = 1500
        c.founder_chloro = 12
        c.founder_mouth = 1
    } else {
        c.habitat = HAB_DISH
        c.flow = 0.12
        c.regrow = 0.02
        c.founders = 1500
        c.transfer_every = 600
        c.transfer_keep = 0.1
        c.sex = 0.0
        c.medium = 1.0
        c.founder_bacterial = true
    }
    return c
}

# A petri dish: everything outside a circle is the dish wall.
const DISH_R: f32 = 118.0
# A slide's chamber: a long rectangle.
const SLIDE_X0: i32 = 6
const SLIDE_X1: i32 = 250
const SLIDE_Y0: i32 = 70
const SLIDE_Y1: i32 = 186

export function in_vessel(habitat: i32, x: i32, y: i32) -> bool {
    if habitat == HAB_DISH {
        let dx: f32 = (x as f32) + 0.5 - 128.0
        let dy: f32 = (y as f32) + 0.5 - 128.0
        return dx * dx + dy * dy < DISH_R * DISH_R
    }
    if habitat == HAB_SLIDE {
        return x >= SLIDE_X0 and x < SLIDE_X1 and y >= SLIDE_Y0 and y < SLIDE_Y1
    }
    return true
}

# Shape the world for the habitat: vessel walls, uniform medium.
export function habitat_apply(l: ptr<Life>) -> void {
    let hab: i32 = l.cfg.habitat
    if hab == HAB_OCEAN { return }
    l.env.passes_open = false
    for y in 0 to WORLD_H {
        for x in 0 to WORLD_W {
            let c: i32 = y * WORLD_W + x
            if in_vessel(hab, x, y) {
                l.env.terrain[c] = TERRAIN_LAND
                l.env.fert[c] = l.cfg.medium
                l.env.food[c] = l.cfg.medium
            } else {
                l.env.terrain[c] = TERRAIN_RIDGE
                l.env.fert[c] = 0.0
                l.env.food[c] = 0.0
            }
        }
    }
    life_terrain_changed(l)
}

# Fields the experiment needs: toxin bands, refuge, light gradient.
export function experiment_fields(l: ptr<Life>, p: i32) -> void {
    if p == P_MEGAPLATE and !l.cfg.no_toxin {
        # Five bands from each end to the middle: none, then 0.6, 1.4, 2.2
        # and 3 units of toxin. Full resistance (all 16 alleles) tolerates
        # TOX_TOL = 4 units, so each band needs about three more alleles.
        let levels: array<f32, 5> = [0.0, 0.6, 1.4, 2.2, 3.0]
        let span: f32 = ((SLIDE_X1 - SLIDE_X0) as f32) * 0.5
        for y in 0 to WORLD_H {
            for x in 0 to WORLD_W {
                let fx: f32 = (x as f32) + 0.5 - (SLIDE_X0 as f32)
                let mut d: f32 = fx
                if span * 2.0 - fx < d { d = span * 2.0 - fx }
                let mut band: i32 = ((d / span) * 5.0) as i32
                if band > 4 { band = 4 }
                if band < 0 { band = 0 }
                l.toxin[y * WORLD_W + x] = levels[band]
            }
        }
        # Medium is the same everywhere: only the drug differs.
    }
    if p == P_REFUGE {
        for y in 0 to WORLD_H {
            for x in 0 to 48 {
                l.refuge[y * WORLD_W + x] = 1 as u8
            }
        }
    }
    if p == P_PHOTOTAXIS and l.cfg.light_uniform {
        # The same total light, spread evenly: the mean of the gradient.
        let mut tot: f32 = 0.0
        for x in SLIDE_X0 to SLIDE_X1 {
            let t: f32 = ((x as f32) - (SLIDE_X0 as f32)) / ((SLIDE_X1 - SLIDE_X0) as f32)
            tot = tot + 0.04 + 0.96 * t * t
        }
        let mean: f32 = tot / ((SLIDE_X1 - SLIDE_X0) as f32)
        for c in 0 to WORLD_CELLS {
            l.lightmap[c] = mean
        }
    } elif p == P_PHOTOTAXIS {
        for y in 0 to WORLD_H {
            for x in 0 to WORLD_W {
                let t: f32 = ((x as f32) - (SLIDE_X0 as f32)) / ((SLIDE_X1 - SLIDE_X0) as f32)
                let mut v: f32 = 0.04 + 0.96 * t * t
                if v < 0.04 { v = 0.04 }
                if v > 1.0 { v = 1.0 }
                l.lightmap[y * WORLD_W + x] = v
            }
        }
    }
}

# Turn founder i into a predator: in body-plan modes, spikes beside the
# core; in morph mode, raptorial organelles, a larger body and no
# cytostome, so it lives only on prey. A distinct
# hue marks them.
function make_predator(l: ptr<Life>, i: i32) -> void {
    let g: ptr<u32> = l.genome
    let gb: i32 = i * L_WORDS
    prog_set(g, gb, 0, make_gene0(CELL_CORE, 0, grow_to(1), grow_to(3), grow_to(2), 8), make_gene1(0, 0, 0, 0))
    prog_set(g, gb, 3, make_gene0(CELL_SPIKE, 0, 0, 0, 0, 8), make_gene1(0, 0, 0, 0))
    l_set_dosage(g, gb, M_RAPTOR, 4, 6)
    # No cytostome: like Didinium, the founding predator cannot graze.
    # Mutation can give one back.
    l_set_dosage(g, gb, M_MOUTH, 6, 0)
    l_set_dosage(g, gb, M_SIZE, 8, 6)
    l_set_dosage(g, gb, M_HUE, 8, 13)
    l_set_dosage(g, gb, M_EYESPOT, 4, 6)
    l_set_int(g, gb, M_FLAGN, 3, 2)
    for b in 0 to 30 {
        l_set_locus(g, gb, LOC_MARK + b, b < 10 or b >= 25)
        l_set_locus(g, gb + L_CHROMS, LOC_MARK + b, b < 10 or b >= 25)
    }
    let x: f32 = l.cr[i].px
    let y: f32 = l.cr[i].py
    let hd: f32 = l.cr[i].hd
    let seed: u32 = l.cr[i].seed
    let age: i32 = l.cr[i].age
    life_express(l, i)
    l.cr[i].px = x
    l.cr[i].py = y
    l.cr[i].hd = hd
    l.cr[i].en = 0.6 * l.cr[i].ecap
    l.cr[i].seed = seed
    l.cr[i].age = age
    l.cr[i].cd = 0
    l.cr[i].kills = 0
    l.cr[i].gen = 0
}

# A new world for preset p in the given mode and body dimensions.
export function life_create(seed: u32, p: i32, mode: i32, dims: i32) -> Life {
    return life_create_cfg(seed, p, preset_cfg(p, mode, dims))
}

# The same, with a configuration already adjusted (experiment controls).
export function life_create_cfg(seed: u32, p: i32, cfg: LifeCfg) -> Life {
    let mode: i32 = cfg.mode
    let dims: i32 = cfg.dims
    let mut l: Life = life_new(seed, cfg)
    habitat_apply(&l)
    experiment_fields(&l, p)
    life_found(&l)
    if p == P_GAUSE or p == P_REFUGE {
        # One in eight founders is a predator. Founders are re-expressed in
        # slot order, so the arena stays packed: rebuild every body.
        l.cell_used = 0
        let mut st: u32 = rng_stream(seed, 0 as u32, 19 as u32)
        for i in 0 to l.n {
            if rng_below(&st, 8) == 0 {
                make_predator(&l, i)
            } else {
                let x: f32 = l.cr[i].px
                let y: f32 = l.cr[i].py
                let hd: f32 = l.cr[i].hd
                let s: u32 = l.cr[i].seed
                let age: i32 = l.cr[i].age
                let en: f32 = l.cr[i].en
                life_express(&l, i)
                l.cr[i].px = x
                l.cr[i].py = y
                l.cr[i].hd = hd
                l.cr[i].seed = s
                l.cr[i].age = age
                l.cr[i].en = en
                l.cr[i].cd = 0
                l.cr[i].kills = 0
                l.cr[i].gen = 0
            }
        }
    }
    if p == P_MEGAPLATE {
        # Inoculate both ends, in the drug-free bands.
        let mut st: u32 = rng_stream(seed, 0 as u32, 23 as u32)
        for i in 0 to l.n {
            let left: bool = rng_below(&st, 2) == 0
            let mut x: f32 = (SLIDE_X0 as f32) + 2.0 + 18.0 * rng_unit(&st)
            if !left { x = (SLIDE_X1 as f32) - 2.0 - 18.0 * rng_unit(&st) }
            l.cr[i].px = x
            l.cr[i].py = (SLIDE_Y0 as f32) + 1.0 + rng_unit(&st) * ((SLIDE_Y1 - SLIDE_Y0 - 2) as f32)
        }
    }
    return l
}

# The open ocean in body-plan mode with 2D bodies: the original world.
export function life_init(seed: u32) -> Life {
    return life_create(seed, P_OCEAN, MODE_PLAN, 2)
}
