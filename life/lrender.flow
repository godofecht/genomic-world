# Drawing the life world: every organism as its own body, and a bestiary
# of the most common body plans.
#
# Cell colours: core in the organism's lineage colour (neutral markers),
# mouth red, motor cyan, eye white, armour grey, store yellow, spike
# magenta. Bodies face along their heading, three pixels per body cell.

import gsim.config
import gsim.state
import gsim.canvas
import .lconfig
import .creature
import .lworld
import .census
import .fluid

extern {
    function cosf(x: f32) -> f32
    function sinf(x: f32) -> f32
}

const L_SCALE: i32 = 3
const L_VIEW: i32 = 768
const L_PANEL_X: i32 = 784
const L_WIN_W: i32 = 1192
const L_WIN_H: i32 = 768

struct LifeUi {
    steps: i32,
    paused: bool,
    zoom: bool,
    zx: i32,
    zy: i32,
    flow_view: bool
}

# Zoom lens: a ZOOM_CELLS x ZOOM_CELLS window of the world at 12 pixels per
# cell, so bodies show at four pixels per body cell.
const ZOOM_CELLS: i32 = 64
const ZOOM_PX: i32 = 12

function type_r(t: i32, col: u32) -> i32 {
    if t == CELL_MOUTH { return 240 }
    if t == CELL_MOTOR { return 70 }
    if t == CELL_EYE { return 250 }
    if t == CELL_ARMOR { return 135 }
    if t == CELL_STORE { return 240 }
    if t == CELL_SPIKE { return 225 }
    return ((col >> 16) & (255 as u32)) as i32
}
function type_g(t: i32, col: u32) -> i32 {
    if t == CELL_MOUTH { return 90 }
    if t == CELL_MOTOR { return 200 }
    if t == CELL_EYE { return 250 }
    if t == CELL_ARMOR { return 135 }
    if t == CELL_STORE { return 210 }
    if t == CELL_SPIKE { return 70 }
    return ((col >> 8) & (255 as u32)) as i32
}
function type_b(t: i32, col: u32) -> i32 {
    if t == CELL_MOUTH { return 70 }
    if t == CELL_MOTOR { return 230 }
    if t == CELL_EYE { return 250 }
    if t == CELL_ARMOR { return 145 }
    if t == CELL_STORE { return 80 }
    if t == CELL_SPIKE { return 225 }
    return (col & (255 as u32)) as i32
}

function clampi(v: i32) -> i32 {
    if v < 0 { return 0 }
    if v > 255 { return 255 }
    return v
}

# Ground: nutrients in green, and the water's vorticity as a red (clockwise)
# or blue (anticlockwise) tint. In flow view the vorticity alone, strongly.
function draw_ground(cv: Canvas, env: ptr<World>, fl: ptr<Fluid>, flow_view: bool) -> void {
    let food: ptr<f32> = env.food
    let terrain: ptr<u8> = env.terrain
    let open: bool = env.passes_open
    let pix: ptr<u8> = cv.px
    let stride: i32 = cv.w * 3
    parallel for y in 0 to WORLD_H {
        for x in 0 to WORLD_W {
            let c: i32 = y * WORLD_W + x
            let f: f32 = food[c]
            let t: u8 = terrain[c]
            let w: f32 = fluid_curl(fl, x >> 1, y >> 1)
            let mut gain: f32 = 220.0
            if flow_view { gain = 1400.0 }
            let mut wr: i32 = (w * gain) as i32
            let mut wb: i32 = (0.0 - w * gain) as i32
            if wr < 0 { wr = 0 }
            if wb < 0 { wb = 0 }
            let mut r: i32 = 10 + ((22.0 * f) as i32) + wr
            let mut g: i32 = 14 + ((60.0 * f) as i32)
            let mut b: i32 = 14 + ((20.0 * f) as i32) + wb
            if flow_view {
                r = 12 + wr
                g = 14 + ((wr + wb) / 4)
                b = 18 + wb
            }
            if r > 255 { r = 255 }
            if b > 255 { b = 255 }
            if g > 255 { g = 255 }
            if t == TERRAIN_RIDGE {
                r = 70
                g = 64
                b = 60
            } elif t == TERRAIN_PASS {
                if open {
                    r = 92
                    g = 80
                    b = 54
                } else {
                    r = 130
                    g = 46
                    b = 40
                }
            }
            for sy in 0 to L_SCALE {
                let mut o: i32 = (y * L_SCALE + sy) * stride + x * L_SCALE * 3
                for sx in 0 to L_SCALE {
                    pix[o] = r as u8
                    pix[o + 1] = g as u8
                    pix[o + 2] = b as u8
                    o = o + 3
                }
            }
        }
    }
}

function put2(cv: Canvas, x: i32, y: i32, r: i32, g: i32, b: i32) -> void {
    for dy in 0 to 3 {
        for dx in 0 to 3 {
            let xx: i32 = x + dx
            let yy: i32 = y + dy
            if xx >= 0 and yy >= 0 and xx < L_VIEW and yy < L_VIEW {
                let o: i32 = (yy * cv.w + xx) * 3
                cv.px[o] = r as u8
                cv.px[o + 1] = g as u8
                cv.px[o + 2] = b as u8
            }
        }
    }
}

function draw_bodies(cv: Canvas, l: ptr<Life>) -> void {
    for i in 0 to l.n {
        let c: Creature = l.cr[i]
        let cx: f32 = c.px * (L_SCALE as f32)
        let cy: f32 = c.py * (L_SCALE as f32)
        let co: f32 = cosf(c.hd)
        let si: f32 = sinf(c.hd)
        let bb: i32 = i * BODY_CELLS
        for by in 0 to BODY {
            for bx in 0 to BODY {
                let t: i32 = l.body[bb + by * BODY + bx] as i32
                if t != 0 {
                    let dx: f32 = (bx - 3) as f32
                    let dy: f32 = (by - 3) as f32
                    let rx: f32 = co * dx - si * dy
                    let ry: f32 = si * dx + co * dy
                    put2(cv, (cx + 3.0 * rx) as i32, (cy + 3.0 * ry) as i32,
                         type_r(t, c.col), type_g(t, c.col), type_b(t, c.col))
                }
            }
        }
    }
}

# One body plan, unrotated, at `px` pixels per cell.
function draw_plan(cv: Canvas, l: ptr<Life>, i: i32, x0: i32, y0: i32, px: i32) -> void {
    let bb: i32 = i * BODY_CELLS
    let col: u32 = l.cr[i].col
    for by in 0 to BODY {
        for bx in 0 to BODY {
            let t: i32 = l.body[bb + by * BODY + bx] as i32
            if t != 0 {
                cv_rect(cv, x0 + bx * px, y0 + by * px, px - 1, px - 1,
                        type_r(t, col), type_g(t, col), type_b(t, col))
            }
        }
    }
}

const LI_R: i32 = 236
const LI_G: i32 = 230
const LI_B: i32 = 218

function dim(cv: Canvas, x: i32, y: i32, s: string) -> i32 {
    return cv_text(cv, x, y, s, 128, 122, 112)
}

function kv(cv: Canvas, x: i32, y: i32, name: string, v: f32, dec: i32) -> void {
    let a: i32 = dim(cv, x, y, name)
    let b: i32 = cv_fixed(cv, x + 66, y, v, dec, LI_R, LI_G, LI_B)
}

function spark(cv: Canvas, cs: ptr<Census>, data: ptr<f32>, x0: i32, y0: i32, name: string,
               cur: f32, dec: i32, hi: f32, r: i32, g: i32, b: i32) -> void {
    let a: i32 = dim(cv, x0, y0, name)
    let v: i32 = cv_fixed(cv, x0 + 330, y0, cur, dec, LI_R, LI_G, LI_B)
    let top: i32 = y0 + 10
    let h: i32 = 26
    cv_rect(cv, x0, top, 384, h, 22, 22, 26)
    let n: i32 = cs.hist_count
    for k in 0 to n {
        let idx: i32 = (cs.hist_head - n + k + 256) % 256
        let mut u: f32 = data[idx] / hi
        if u > 1.0 { u = 1.0 }
        if u < 0.0 { u = 0.0 }
        cv_rect(cv, x0 + (k * 384) / 256, top + h - 1 - ((u * ((h - 2) as f32)) as i32), 2, 2, r, g, b)
    }
}

# A sparkline around zero, for quantities that change sign.
function spark_signed(cv: Canvas, cs: ptr<Census>, data: ptr<f32>, x0: i32, y0: i32, name: string,
                      cur: f32, dec: i32, span: f32, r: i32, g: i32, b: i32) -> void {
    let a: i32 = dim(cv, x0, y0, name)
    let v: i32 = cv_fixed(cv, x0 + 330, y0, cur, dec, LI_R, LI_G, LI_B)
    let top: i32 = y0 + 10
    let h: i32 = 26
    cv_rect(cv, x0, top, 384, h, 22, 22, 26)
    cv_rect(cv, x0, top + h / 2, 384, 1, 70, 70, 76)
    let n: i32 = cs.hist_count
    for k in 0 to n {
        let idx: i32 = (cs.hist_head - n + k + 256) % 256
        let mut u: f32 = data[idx] / span
        if u > 1.0 { u = 1.0 }
        if u < -1.0 { u = -1.0 }
        cv_rect(cv, x0 + (k * 384) / 256, top + h / 2 - ((u * ((h / 2 - 1) as f32)) as i32), 2, 2, r, g, b)
    }
}

function draw_panel(cv: Canvas, l: ptr<Life>, cs: ptr<Census>, ui: LifeUi) -> void {
    let x0: i32 = L_PANEL_X
    cv_rect(cv, L_VIEW, 0, L_WIN_W - L_VIEW, L_WIN_H, 14, 14, 17)
    let t0: i32 = cv_text(cv, x0, 10, "LIFE WORLD", 250, 196, 110)
    let t1: i32 = dim(cv, x0 + 72, 10, "BODIES GROWN FROM GENOMES, BRAINS EVOLVED")
    let mut y: i32 = 28
    let a1: i32 = dim(cv, x0, y, "TICK")
    let a2: i32 = cv_int(cv, x0 + 30, y, l.tick as i32, LI_R, LI_G, LI_B)
    let a3: i32 = dim(cv, x0 + 96, y, "ALIVE")
    let a4: i32 = cv_int(cv, x0 + 132, y, l.n, LI_R, LI_G, LI_B)
    let a5: i32 = dim(cv, x0 + 190, y, "GENERATIONS")
    let a6: i32 = cv_int(cv, x0 + 262, y, cs.max_gen, LI_R, LI_G, LI_B)
    if ui.paused {
        let a7: i32 = cv_text(cv, x0 + 330, y, "PAUSED", 255, 110, 110)
    }
    y = y + 12
    let b1: i32 = dim(cv, x0, y, "BIRTHS")
    let b2: i32 = cv_int(cv, x0 + 42, y, l.births, LI_R, LI_G, LI_B)
    let b3: i32 = dim(cv, x0 + 96, y, "KILLS")
    let b4: i32 = cv_int(cv, x0 + 132, y, l.kills, LI_R, LI_G, LI_B)
    let b5: i32 = dim(cv, x0 + 190, y, "MATES REFUSED")
    let b6: i32 = cv_int(cv, x0 + 274, y, l.rejected, LI_R, LI_G, LI_B)
    y = y + 18
    kv(cv, x0, y, "CELLS", cs.mean_cells, 2)
    kv(cv, x0 + 130, y, "EYES", cs.mean_eyes, 2)
    kv(cv, x0 + 260, y, "SPEED", cs.mean_speed, 2)
    y = y + 12
    kv(cv, x0, y, "DEFENCE", cs.mean_armor, 2)
    kv(cv, x0 + 130, y, "PREDATORS", cs.predators, 3)
    kv(cv, x0 + 260, y, "PLANS", cs.plans as f32, 0)

    y = 96
    let s1: i32 = cv_text(cv, x0, y, "BESTIARY  MOST COMMON BODY PLANS", LI_R, LI_G, LI_B)
    for k in 0 to BESTIARY {
        let tx: i32 = x0 + (k % 4) * 98
        let ty: i32 = y + 14 + (k / 4) * 110
        cv_rect(cv, tx, ty, 92, 104, 22, 22, 26)
        let i: i32 = cs.top[k]
        if i >= 0 and i < l.n {
            draw_plan(cv, l, i, tx + 11, ty + 6, 10)
            let c: Creature = l.cr[i]
            let n1: i32 = cv_int(cv, tx + 4, ty + 80, cs.top_count[k], LI_R, LI_G, LI_B)
            let mut role: string = "GRAZER"
            if c.attack > 0.0 and c.mouths > 0 { role = "PREDATOR" }
            if c.mouths == 0 { role = "NO MOUTH" }
            let n2: i32 = cv_text(cv, tx + 40, ty + 80, role, 160, 150, 140)
            let n3: i32 = dim(cv, tx + 4, ty + 92, "A")
            let n4: i32 = cv_int(cv, tx + 12, ty + 92, c.attack as i32, LI_R, LI_G, LI_B)
            let n5: i32 = dim(cv, tx + 28, ty + 92, "D")
            let n6: i32 = cv_fixed(cv, tx + 36, ty + 92, c.defense, 1, LI_R, LI_G, LI_B)
            let n7: i32 = dim(cv, tx + 60, ty + 92, "E")
            let n8: i32 = cv_int(cv, tx + 68, ty + 92, c.eyes, LI_R, LI_G, LI_B)
        }
    }
    let lg: i32 = 344
    let c1: i32 = cv_text(cv, x0, lg, "CORE", 170, 170, 170)
    let c2: i32 = cv_text(cv, x0 + 36, lg, "MOUTH", 240, 90, 70)
    let c3: i32 = cv_text(cv, x0 + 78, lg, "MOTOR", 70, 200, 230)
    let c4: i32 = cv_text(cv, x0 + 120, lg, "EYE", 250, 250, 250)
    let c5: i32 = cv_text(cv, x0 + 150, lg, "ARMOUR", 135, 135, 145)
    let c6: i32 = cv_text(cv, x0 + 198, lg, "STORE", 240, 210, 80)
    let c7: i32 = cv_text(cv, x0 + 240, lg, "SPIKE", 225, 70, 225)

    y = 362
    spark(cv, cs, cs.hist_pop, x0, y, "ORGANISMS", l.n as f32, 0, 20000.0, 220, 220, 220)
    spark(cv, cs, cs.hist_pred, x0, y + 38, "PREDATOR SHARE", cs.predators, 3, 1.0, 225, 70, 225)
    spark(cv, cs, cs.hist_cells, x0, y + 76, "MEAN BODY CELLS", cs.mean_cells, 2, 12.0, 70, 200, 230)
    spark(cv, cs, cs.hist_species, x0, y + 114, "MORPHOSPECIES  PLANS HELD BY 10 OR MORE", cs.morphospecies as f32, 0, 40.0, 250, 196, 110)
    spark(cv, cs, cs.hist_strength, x0, y + 152, "CURRENT STRENGTH  OCEAN REGIME", cs.strength, 2, 1.0, 110, 170, 250)
    spark_signed(cv, cs, cs.hist_selv, x0, y + 190, "SELECTION ON SWIM SPEED  PARENTS MINUS ALL", cs.sel_v, 3, 0.15, 240, 140, 70)

    y = 610
    let k0: i32 = cv_text(cv, x0, y, "KEYS", LI_R, LI_G, LI_B)
    let k1: i32 = dim(cv, x0, y + 14, "P PAUSE    [ ] STEPS PER FRAME")
    let k2: i32 = dim(cv, x0, y + 26, "B OPEN OR CLOSE THE PASSES    W WARM OR COOL")
    let k3: i32 = dim(cv, x0, y + 38, "Z ZOOM  ARROWS PAN  F FLOW VIEW  R NEW  ESC QUIT")
    let k4: i32 = dim(cv, x0, y + 56, "BODIES SWIM IN A 2D INCOMPRESSIBLE FLOW. RED AND")
    let k5: i32 = dim(cv, x0, y + 68, "BLUE ARE VORTICITY; GREEN IS NUTRIENT CARRIED BY")
    let k6: i32 = dim(cv, x0, y + 80, "THE WATER FROM DRIFTING UPWELLING ZONES.")
    let k8: i32 = dim(cv, x0, y + 98, "STEPS")
    let k9: i32 = cv_int(cv, x0 + 36, y + 98, ui.steps, LI_R, LI_G, LI_B)
    let ka: i32 = dim(cv, x0 + 80, y + 98, "SEL ON WIDTH")
    let kb: i32 = cv_fixed(cv, x0 + 158, y + 98, cs.sel_w, 3, LI_R, LI_G, LI_B)
}

function put_n(cv: Canvas, x: i32, y: i32, n: i32, r: i32, g: i32, b: i32) -> void {
    for dy in 0 to n {
        for dx in 0 to n {
            let xx: i32 = x + dx
            let yy: i32 = y + dy
            if xx >= 0 and yy >= 0 and xx < L_VIEW and yy < L_VIEW {
                let o: i32 = (yy * cv.w + xx) * 3
                cv.px[o] = r as u8
                cv.px[o + 1] = g as u8
                cv.px[o + 2] = b as u8
            }
        }
    }
}

function draw_zoom(cv: Canvas, l: ptr<Life>, ui: LifeUi) -> void {
    let food: ptr<f32> = l.env.food
    let terrain: ptr<u8> = l.env.terrain
    for zy in 0 to ZOOM_CELLS {
        for zx in 0 to ZOOM_CELLS {
            let wx: i32 = (ui.zx + zx) & (WORLD_W - 1)
            let wy: i32 = (ui.zy + zy) & (WORLD_H - 1)
            let c: i32 = wy * WORLD_W + wx
            let f: f32 = food[c]
            let mut r: i32 = 10 + ((22.0 * f) as i32)
            let mut g: i32 = 14 + ((60.0 * f) as i32)
            let mut b: i32 = 12 + ((20.0 * f) as i32)
            if terrain[c] != TERRAIN_LAND {
                r = 70
                g = 64
                b = 60
            }
            cv_rect(cv, zx * ZOOM_PX, zy * ZOOM_PX, ZOOM_PX, ZOOM_PX, r, g, b)
        }
    }
    let span: f32 = ZOOM_CELLS as f32
    for i in 0 to l.n {
        let c: Creature = l.cr[i]
        let mut ox: f32 = c.px - (ui.zx as f32)
        let mut oy: f32 = c.py - (ui.zy as f32)
        if ox < 0.0 { ox = ox + (WORLD_W as f32) }
        if oy < 0.0 { oy = oy + (WORLD_H as f32) }
        if ox < span and oy < span {
            let cx: f32 = ox * (ZOOM_PX as f32)
            let cy: f32 = oy * (ZOOM_PX as f32)
            let co: f32 = cosf(c.hd)
            let si: f32 = sinf(c.hd)
            let bb: i32 = i * BODY_CELLS
            for by in 0 to BODY {
                for bx in 0 to BODY {
                    let t: i32 = l.body[bb + by * BODY + bx] as i32
                    if t != 0 {
                        let dx: f32 = (bx - 3) as f32
                        let dy: f32 = (by - 3) as f32
                        let rx: f32 = co * dx - si * dy
                        let ry: f32 = si * dx + co * dy
                        put_n(cv, (cx + 4.0 * rx) as i32 - 2, (cy + 4.0 * ry) as i32 - 2, 4,
                              type_r(t, c.col), type_g(t, c.col), type_b(t, c.col))
                    }
                }
            }
        }
    }
}

export function life_render(cv: Canvas, l: ptr<Life>, cs: ptr<Census>, ui: LifeUi) -> void {
    if ui.zoom {
        draw_zoom(cv, l, ui)
    } else {
        draw_ground(cv, &l.env, &l.fluid, ui.flow_view)
        draw_bodies(cv, l)
    }
    draw_panel(cv, l, cs, ui)
}
