# A census of the living: body plans, trophic roles, sizes, and the
# bestiary of the most common plans.
#
# A body plan is the exact lattice of cell types (hashed). A plan held by at
# least 10 organisms counts as a morphospecies. A predator is an organism
# with at least one spike and one mouth.

import "stdlib/memory.flow"
import .lconfig
import .creature

struct Census {
    keys: ptr<u32>,
    counts: ptr<i32>,
    example: ptr<i32>,
    top: ptr<i32>,
    top_count: ptr<i32>,
    plans: i32,
    morphospecies: i32,
    predators: f32,
    mean_cells: f32,
    mean_eyes: f32,
    mean_speed: f32,
    mean_armor: f32,
    max_gen: i32,
    mean_width: f32,
    sel_v: f32,
    sel_w: f32,
    strength: f32,
    hist_strength: ptr<f32>,
    hist_selv: ptr<f32>,
    hist_width: ptr<f32>,
    hist_pop: ptr<f32>,
    hist_pred: ptr<f32>,
    hist_cells: ptr<f32>,
    hist_species: ptr<f32>,
    hist_head: i32,
    hist_count: i32
}

const L_HIST: i32 = 256

export function census_new() -> Census {
    return Census {
        keys: alloc_zeroed((PLAN_SLOTS as i64) * 4) as ptr<u32>,
        counts: alloc_i32(PLAN_SLOTS as i64),
        example: alloc_i32(PLAN_SLOTS as i64),
        top: alloc_i32(BESTIARY as i64),
        top_count: alloc_i32(BESTIARY as i64),
        plans: 0, morphospecies: 0, predators: 0.0, mean_cells: 0.0,
        mean_eyes: 0.0, mean_speed: 0.0, mean_armor: 0.0, max_gen: 0,
        mean_width: 0.0, sel_v: 0.0, sel_w: 0.0, strength: 0.0,
        hist_strength: alloc_f32(L_HIST as i64),
        hist_selv: alloc_f32(L_HIST as i64),
        hist_width: alloc_f32(L_HIST as i64),
        hist_pop: alloc_f32(L_HIST as i64),
        hist_pred: alloc_f32(L_HIST as i64),
        hist_cells: alloc_f32(L_HIST as i64),
        hist_species: alloc_f32(L_HIST as i64),
        hist_head: 0, hist_count: 0
    }
}

export function census_take(cs: ptr<Census>, cr: ptr<Creature>, n: i32) -> void {
    for k in 0 to PLAN_SLOTS {
        cs.counts[k] = 0
    }
    let mut pred: i32 = 0
    let mut cells: f64 = 0.0
    let mut eyes: f64 = 0.0
    let mut speed: f64 = 0.0
    let mut armor: f64 = 0.0
    let mut width: f64 = 0.0
    let mut gmax: i32 = 0
    cs.plans = 0
    for i in 0 to n {
        if cr[i].attack > 0.0 and cr[i].mouths > 0 { pred = pred + 1 }
        cells = cells + (cr[i].cells as f64)
        eyes = eyes + (cr[i].eyes as f64)
        speed = speed + (cr[i].vmax as f64)
        armor = armor + (cr[i].defense as f64)
        width = width + (cr[i].width as f64)
        if cr[i].gen > gmax { gmax = cr[i].gen }
        # Open addressing on the plan hash.
        let key: u32 = cr[i].plan | (1 as u32)
        let mut slot: i32 = (key % (PLAN_SLOTS as u32)) as i32
        let mut placed: bool = false
        let mut probes: i32 = 0
        while !placed and probes < PLAN_SLOTS {
            if cs.counts[slot] == 0 {
                cs.keys[slot] = key
                cs.counts[slot] = 1
                cs.example[slot] = i
                cs.plans = cs.plans + 1
                placed = true
            } elif cs.keys[slot] == key {
                cs.counts[slot] = cs.counts[slot] + 1
                placed = true
            } else {
                slot = (slot + 1) % PLAN_SLOTS
                probes = probes + 1
            }
        }
    }
    let fn: f64 = n as f64
    if n > 0 {
        cs.predators = ((pred as f64) / fn) as f32
        cs.mean_cells = (cells / fn) as f32
        cs.mean_eyes = (eyes / fn) as f32
        cs.mean_speed = (speed / fn) as f32
        cs.mean_armor = (armor / fn) as f32
        cs.mean_width = (width / fn) as f32
    }
    cs.max_gen = gmax
    cs.morphospecies = 0
    for b in 0 to BESTIARY {
        cs.top[b] = -1
        cs.top_count[b] = 0
    }
    for k in 0 to PLAN_SLOTS {
        let c: i32 = cs.counts[k]
        if c >= 10 { cs.morphospecies = cs.morphospecies + 1 }
        if c > cs.top_count[BESTIARY - 1] {
            let mut p: i32 = BESTIARY - 1
            while p > 0 and c > cs.top_count[p - 1] {
                cs.top_count[p] = cs.top_count[p - 1]
                cs.top[p] = cs.top[p - 1]
                p = p - 1
            }
            cs.top_count[p] = c
            cs.top[p] = cs.example[k]
        }
    }
}

# Selection differentials through reproduction since the last call: the
# mean trait of parents (each birth counts both parents) minus the mean of
# the living. Positive means selection currently favours larger values.
export function census_selection(cs: ptr<Census>, par_v: f64, par_w: f64, par_n: f64, strength: f32) -> void {
    cs.strength = strength
    if par_n > 0.0 {
        cs.sel_v = ((par_v / par_n) as f32) - cs.mean_speed
        cs.sel_w = ((par_w / par_n) as f32) - cs.mean_width
    }
}

export function census_record(cs: ptr<Census>, n: i32) -> void {
    let k: i32 = cs.hist_head
    cs.hist_strength[k] = cs.strength
    cs.hist_selv[k] = cs.sel_v
    cs.hist_width[k] = cs.mean_width
    cs.hist_pop[k] = n as f32
    cs.hist_pred[k] = cs.predators
    cs.hist_cells[k] = cs.mean_cells
    cs.hist_species[k] = cs.morphospecies as f32
    cs.hist_head = (k + 1) % L_HIST
    if cs.hist_count < L_HIST { cs.hist_count = cs.hist_count + 1 }
}
