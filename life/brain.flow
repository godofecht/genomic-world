# The nervous system: one layer from seven inputs to two outputs.
#
#   inputs   0 food to the front-left    1 food ahead    2 food front-right
#            3 prey direction (+ left, - right, weighted by nearness)
#            4 threat direction (same convention)
#            5 own energy as a fraction of capacity
#            6 constant 1 (bias)
#   outputs  0 turn: clamp(sum, -1, 1), positive turns left
#            1 thrust: logistic(sum), 0 to 1 of top speed
#
# Weight k = output * 7 + input. Weights come from the genome (lgenome.flow)
# and are decoded once at birth into the brain array.

import .lconfig

extern {
    function expf(x: f32) -> f32
}

export function brain_turn(w: ptr<f32>, wb: i32, x: ptr<f32>) -> f32 {
    let mut s: f32 = 0.0
    for k in 0 to BRAIN_IN {
        s = s + w[wb + k] * x[k]
    }
    if s > 1.0 { return 1.0 }
    if s < -1.0 { return -1.0 }
    return s
}

export function brain_thrust(w: ptr<f32>, wb: i32, x: ptr<f32>) -> f32 {
    let mut s: f32 = 0.0
    for k in 0 to BRAIN_IN {
        s = s + w[wb + BRAIN_IN + k] * x[k]
    }
    return 1.0 / (1.0 + expf(0.0 - s))
}
