# Development: a body grows from one cell.
#
# The first cell sits at the origin with identity 0, facing +x. Each round,
# every cell in the upper half (y <= 0) whose identity gene's timer has not
# run out looks in each direction (east, north, west, south, and in 3D up
# and down). Where the gene's grow bit is set and the neighbour is empty and
# still in the upper half, a new cell appears there with the target
# identity. Cells made in a round start growing the next round. When a
# round adds nothing, growth has stopped. Last, the upper half is mirrored
# onto the lower, so every body is bilaterally symmetric, as most animals
# are.
#
# Nothing fixes the number of cells or their arrangement: segments repeat
# when an identity grows itself, organs appear where identities differ,
# and duplicated genes give new identities to work with. Only the scratch
# grid (DEV_R in 2D, DEV_R3 in 3D, each way) bounds a body's extent.
#
# A body is a list of cells, one u32 each:
#   bits  0-6   x + 64       bits 19-22  cell type
#   bits  7-13  y + 64       bits 23-26  cell size (combined mode look)
#   bits 14-18  z + 16       bits 27-30  hue shift (combined mode look)

import "stdlib/memory.flow"
import .lconfig
import .lgenome

const DEV_G2: i32 = 64
const DEV_G3: i32 = 32
const DEV_LIST: i32 = 32768

struct DevScratch {
    grid: ptr<u8>,
    xs: ptr<i32>,
    ys: ptr<i32>,
    zs: ptr<i32>,
    id: ptr<i32>,
    born: ptr<i32>
}

export function dev_scratch() -> DevScratch {
    let n: i64 = DEV_LIST as i64
    return DevScratch {
        grid: alloc_zeroed(n) as ptr<u8>,
        xs: alloc_i32(n), ys: alloc_i32(n), zs: alloc_i32(n),
        id: alloc_i32(n), born: alloc_i32(n)
    }
}

export function cell_x(c: u32) -> i32 { return ((c & (127 as u32)) as i32) - 64 }
export function cell_y(c: u32) -> i32 { return (((c >> (7 as u32)) & (127 as u32)) as i32) - 64 }
export function cell_z(c: u32) -> i32 { return (((c >> (14 as u32)) & (31 as u32)) as i32) - 16 }
export function cell_type(c: u32) -> i32 { return ((c >> (19 as u32)) & (15 as u32)) as i32 }
export function cell_size(c: u32) -> i32 { return ((c >> (23 as u32)) & (15 as u32)) as i32 }
export function cell_hue(c: u32) -> i32 { return ((c >> (27 as u32)) & (15 as u32)) as i32 }

export function cell_pack(x: i32, y: i32, z: i32, t: i32, size: i32, hue: i32) -> u32 {
    return ((x + 64) as u32) | (((y + 64) as u32) << (7 as u32)) | (((z + 16) as u32) << (14 as u32))
         | ((t as u32) << (19 as u32)) | ((size as u32) << (23 as u32)) | ((hue as u32) << (27 as u32))
}

function grid_at(dims: i32, x: i32, y: i32, z: i32) -> i32 {
    if dims == 3 {
        return ((z + 16) * DEV_G3 + (y + 16)) * DEV_G3 + (x + 16)
    }
    return (y + 32) * DEV_G2 + (x + 32)
}

function dir_dx(d: i32) -> i32 {
    if d == 0 { return 1 }
    if d == 2 { return -1 }
    return 0
}

function dir_dy(d: i32) -> i32 {
    if d == 1 { return -1 }
    if d == 3 { return 1 }
    return 0
}

function dir_dz(d: i32) -> i32 {
    if d == 4 { return 1 }
    if d == 5 { return -1 }
    return 0
}

# Grow a body from the expressed program prog[pb..] for at most `rounds`
# rounds, in 2D or 3D, writing its cells to out[ob..]. Returns the number
# of cells.
export function develop(prog: ptr<u32>, pb: i32, dims: i32, rounds: i32,
                        sc: ptr<DevScratch>, out: ptr<u32>, ob: i32) -> i32 {
    let k: i32 = prog[pb] as i32
    let mut r_lim: i32 = DEV_R
    if dims == 3 { r_lim = DEV_R3 }
    let mut ndir: i32 = 4
    if dims == 3 { ndir = 6 }
    let mut n: i32 = 1
    sc.xs[0] = 0
    sc.ys[0] = 0
    sc.zs[0] = 0
    sc.id[0] = 0
    sc.born[0] = 0
    sc.grid[grid_at(dims, 0, 0, 0)] = 1 as u8
    for r in 0 to rounds {
        let m: i32 = n
        for c in 0 to m {
            if sc.ys[c] <= 0 {
                let ident: i32 = sc.id[c]
                let w0: u32 = prog[pb + 1 + 2 * ident]
                let w1: u32 = prog[pb + 2 + 2 * ident]
                let timer: i32 = gene_field(w0, 3, 4)
                if r - sc.born[c] <= timer {
                    for d in 0 to ndir {
                        let f: i32 = gene_dir(w0, w1, d)
                        if (f & 64) != 0 {
                            let nx: i32 = sc.xs[c] + dir_dx(d)
                            let ny: i32 = sc.ys[c] + dir_dy(d)
                            let nz: i32 = sc.zs[c] + dir_dz(d)
                            if nx >= 0 - r_lim and nx <= r_lim and ny >= 0 - r_lim and ny <= 0
                               and nz >= 0 - r_lim and nz <= r_lim and n < DEV_LIST / 2 {
                                let gi: i32 = grid_at(dims, nx, ny, nz)
                                if sc.grid[gi] == (0 as u8) {
                                    sc.grid[gi] = 1 as u8
                                    sc.xs[n] = nx
                                    sc.ys[n] = ny
                                    sc.zs[n] = nz
                                    sc.id[n] = (f & 63) % k
                                    sc.born[n] = r + 1
                                    n = n + 1
                                }
                            }
                        }
                    }
                }
            }
        }
        if n == m { break }
    }
    # Mirror the upper half onto the lower.
    let upper: i32 = n
    for c in 0 to upper {
        if sc.ys[c] < 0 {
            sc.xs[n] = sc.xs[c]
            sc.ys[n] = 0 - sc.ys[c]
            sc.zs[n] = sc.zs[c]
            sc.id[n] = sc.id[c]
            n = n + 1
        }
    }
    for c in 0 to n {
        let ident: i32 = sc.id[c]
        let w0: u32 = prog[pb + 1 + 2 * ident]
        let w1: u32 = prog[pb + 2 + 2 * ident]
        out[ob + c] = cell_pack(sc.xs[c], sc.ys[c], sc.zs[c], gene_field(w0, 0, 3) + 1,
                                gene_field(w0, 28, 4), gene_field(w1, 21, 4))
        if sc.ys[c] <= 0 {
            sc.grid[grid_at(dims, sc.xs[c], sc.ys[c], sc.zs[c])] = 0 as u8
        }
    }
    return n
}

export function count_cells(cells: ptr<u32>, off: i32, n: i32, t: i32) -> i32 {
    let mut c: i32 = 0
    for k in 0 to n {
        if cell_type(cells[off + k]) == t { c = c + 1 }
    }
    return c
}

# FNV-1a over cell positions and types: the body plan's identity in the
# census.
export function body_hash(cells: ptr<u32>, off: i32, n: i32) -> u32 {
    let mut h: u32 = 2166136261 as u32
    for k in 0 to n {
        h = (h ^ (cells[off + k] & (0x7fffff as u32))) * (16777619 as u32)
    }
    return h
}
